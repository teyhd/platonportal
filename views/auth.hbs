<main class="mx-auto max-w-md px-4 py-20">
  <section class="rounded-lg border border-slate-200 bg-white p-6 text-slate-950 shadow-sm" aria-labelledby="signin-title">
    <h1 id="signin-title" class="mb-4 text-xl font-semibold">Вход по PIN</h1>
    {{> pinForm pinId="page-pin" loginError=loginError}}
