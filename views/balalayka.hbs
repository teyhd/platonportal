<main class="max-w-6xl mx-auto px-4 pt-10 pb-6 text-white md:px-6 lg:px-8">
  <section class="overflow-hidden rounded-[32px] border border-white/10 bg-[linear-gradient(180deg,_rgba(19,28,69,0.96)_0%,_rgba(10,16,40,0.98)_100%)] shadow-[0_30px_80px_rgba(2,6,23,0.45)]">
    <div class="px-6 py-10 md:px-10 md:py-14 lg:px-14 lg:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-300">
          Платоникс · Балалайка
        </div>
        <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-5xl lg:text-6xl">
          Корпоративный мессенджер нового поколения
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-300 md:text-lg">
          Балалайка делает рабочее общение быстрее, тише и понятнее.
          Один продукт, в котором переписка, форумы, реакции и медиа ощущаются собранно на всех платформах.
        </p>
      </div>
    </div>
  </section>

  <section class="mt-6 overflow-hidden rounded-[32px] border border-white/10 bg-[linear-gradient(180deg,_rgba(255,255,255,0.05)_0%,_rgba(255,255,255,0.02)_100%)] shadow-[0_24px_60px_rgba(2,6,23,0.28)]">
    <div class="px-6 py-8 md:px-10 md:py-10">
      <div class="mx-auto max-w-4xl text-center">
        <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-300">Установите Балалайку</div>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">
          Приложение уже готово для команды
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-300 md:text-base">
          Выберите свою платформу и установите Балалайку через официальный каталог или TestFlight.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
          {{#each installButtons}}
            <a href="{{this.href}}" target="_blank" rel="noopener noreferrer"
               class="group relative inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] p-2 transition-all duration-200 hover:border-white/20 hover:bg-white/[0.08] hover:-translate-y-0.5"
               aria-label="{{this.alt}}">
              <img src="{{this.img}}" alt="{{this.alt}}" class="h-14 md:h-[58px] w-auto" />
              <span class="absolute -right-2 -top-2 rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold text-slate-900 shadow">{{this.note}}</span>
            </a>
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-8">
    <div class="max-w-3xl">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-400">Что нового</div>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">
        Обновление, которое чувствуется в ежедневной работе
      </h2>
      <p class="mt-4 text-sm leading-7 text-slate-300 md:text-base">
        Ниже только главное, без перегруза и лишнего шума.
      </p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {{#each changelogGroups}}
        <article class="rounded-[28px] border border-white/10 bg-gray-900/60 px-6 py-6 shadow-[0_20px_40px_rgba(2,6,23,0.22)] backdrop-blur-sm transition-all duration-200 hover:border-white/15 hover:bg-gray-900/72">
          <h3 class="text-2xl font-semibold tracking-tight text-white">{{this.title}}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-400 md:text-[15px]">{{this.lead}}</p>
          <ul class="mt-5 space-y-4 text-sm leading-7 text-slate-300 md:text-base">
            {{#each this.items}}
              <li class="flex gap-3">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-white/80"></span>
                <span>{{this}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
      {{/each}}
    </div>
  </section>
</main>

<footer class="pb-8 pt-12 text-center text-sm text-gray-500 dark:text-gray-400">
  © 2026 Балалайка · Платоникс
</footer>
