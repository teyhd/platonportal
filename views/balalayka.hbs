  @media (max-width: 767px) {
    .bl-final-band {
      padding: 32px 20px;
    }

    .bl-platform-card,
    .bl-update-card,
    .bl-proof-item {
      padding: 20px;
    }

    .bl-notification-card-offset {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .bl-reveal,
    .bl-reveal.is-visible,
    .bl-showcase-copy,
    .bl-showcase-copy.is-active,
    .bl-showcase-visual,
    .bl-showcase-visual.is-active,
    .bl-parallax-layer,
    .bl-progress-fill,
    .bl-emoji-burst::after,
    .bl-room-dot,
    .bl-notification-mark {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (() => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const reveals = Array.from(document.querySelectorAll('[data-reveal]'));
    if (reducedMotion || !('IntersectionObserver' in window)) {
      reveals.forEach((node) => node.classList.add('is-visible'));
    } else {
      document.querySelectorAll('[data-stagger="platform"]').forEach((node, index) => {
        node.style.transitionDelay = `${120 + index * 70}ms`;
      });
      document.querySelectorAll('[data-stagger="update"]').forEach((node, index) => {
        node.style.transitionDelay = `${160 + index * 70}ms`;
      });
      reveals.forEach((node) => {
        if (!node.style.transitionDelay) node.style.transitionDelay = '40ms';
      });

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      }, {
        threshold: 0.14,
        rootMargin: '0px 0px -60px 0px'
      });

      reveals.forEach((node) => revealObserver.observe(node));
    }

    const showcaseButtons = Array.from(document.querySelectorAll('[data-showcase-trigger]'));
    const showcaseCopies = Array.from(document.querySelectorAll('[data-showcase-copy]'));
    const showcaseVisuals = Array.from(document.querySelectorAll('[data-showcase-visual]'));
    let showcaseTimer = null;
    let showcaseUserControlled = false;

    const activateShowcase = (id) => {
      showcaseButtons.forEach((button) => {
        const active = button.dataset.showcaseTrigger === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      showcaseCopies.forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.showcaseCopy === id);
      });

      showcaseVisuals.forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.showcaseVisual === id);
      });
    };

    const scheduleShowcase = () => {
      if (reducedMotion || showcaseUserControlled || showcaseButtons.length < 2) return;
      clearInterval(showcaseTimer);
      showcaseTimer = setInterval(() => {
        const currentIndex = showcaseButtons.findIndex((button) => button.classList.contains('is-active'));
        const next = showcaseButtons[(currentIndex + 1) % showcaseButtons.length];
        if (next) activateShowcase(next.dataset.showcaseTrigger);
      }, 5400);
    };

    showcaseButtons.forEach((button) => {
      button.addEventListener('click', () => {
        showcaseUserControlled = true;
        clearInterval(showcaseTimer);
        activateShowcase(button.dataset.showcaseTrigger);
      });
    });
    scheduleShowcase();

    const heroStage = document.getElementById('hero-stage');
    if (heroStage && !reducedMotion) {
      heroStage.addEventListener('mousemove', (event) => {
        const rect = heroStage.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        heroStage.style.setProperty('--parallax-x', `${x * 26}px`);
        heroStage.style.setProperty('--parallax-y', `${y * 22}px`);
      });

      heroStage.addEventListener('mouseleave', () => {
        heroStage.style.setProperty('--parallax-x', '0px');
        heroStage.style.setProperty('--parallax-y', '0px');
      });
    }

  })();
</script>
