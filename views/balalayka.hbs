          <source type="image/webp" srcset="/img/balalayka/optimized/android-chat-420.webp 420w, /img/balalayka/optimized/android-chat-768.webp 768w" sizes="(max-width: 799px) 74vw, 32vw">
          <img src="/img/balalayka/android-chat-light.png" width="1080" height="2400" alt="Рабочий чат Балалайки на Android" loading="lazy">
        </picture>
        <figcaption>Настоящий интерфейс Балалайки на телефоне.</figcaption>
      </figure>
    </section>

    <section id="platforms" class="bl-platforms bl-section" aria-labelledby="platforms-title">
      <div class="bl-section-heading">
        <p class="bl-kicker">Один шаг до работы</p>
        <h2 id="platforms-title">Откройте Балалайку там, где вы сейчас.</h2>
