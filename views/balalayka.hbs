<main class="mx-auto max-w-[1120px] px-5 pb-10 pt-12 text-white md:px-8 md:pt-16 lg:px-10 lg:pt-20">
  <section data-reveal class="reveal overflow-hidden rounded-[40px] border border-white/10 bg-[linear-gradient(180deg,_rgba(17,24,39,0.92)_0%,_rgba(15,23,42,0.98)_100%)] shadow-[0_28px_80px_rgba(2,6,23,0.26)]">
    <div class="grid gap-12 px-6 py-10 md:px-10 md:py-14 lg:grid-cols-[minmax(0,1.05fr)_440px] lg:items-center lg:gap-14 lg:px-14 lg:py-16">
      <div class="max-w-[560px]">
        <div class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[11px] font-medium uppercase tracking-[0.24em] text-slate-300">
          Платоникс · Балалайка
        </div>
        <h1 class="mt-6 text-[42px] font-semibold tracking-[-0.04em] text-white sm:text-5xl lg:text-[64px] lg:leading-[1.02]">
          Корпоративный мессенджер нового поколения
        </h1>
        <p class="mt-6 max-w-[520px] text-[17px] leading-8 text-slate-300 md:text-[19px] md:leading-9">
          Балалайка делает рабочее общение быстрее, тише и понятнее.
          Один продукт, в котором переписка, форумы, реакции и медиа ощущаются собранно на всех платформах.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-[440px] lg:mx-0">
        <div class="absolute left-1/2 top-8 h-64 w-64 -translate-x-1/2 rounded-full bg-cyan-200/10 blur-3xl"></div>
        <div class="relative rounded-[36px] border border-white/10 bg-[linear-gradient(180deg,_rgba(255,255,255,0.09)_0%,_rgba(255,255,255,0.03)_100%)] p-3 shadow-[0_32px_80px_rgba(2,6,23,0.34)] backdrop-blur-xl">
          <div class="rounded-[30px] border border-white/10 bg-[#0b1120] p-5">
            <div class="flex items-center justify-between text-[11px] uppercase tracking-[0.18em] text-slate-500">
              <span>Балалайка</span>
              <span>live</span>
            </div>

            <div class="mt-5 rounded-[26px] border border-white/5 bg-[linear-gradient(180deg,_rgba(17,24,39,0.96)_0%,_rgba(15,23,42,0.9)_100%)] p-4">
              <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-[18px] bg-white text-sm font-semibold text-slate-900 shadow-sm">Б</div>
                <div>
                  <div class="text-sm font-semibold text-white">Тема: продукт</div>
                  <div class="mt-1 text-xs text-slate-400">Новый экран выбора тем уже в релизе</div>
                </div>
              </div>

              <div class="mt-5 space-y-3">
                <div class="max-w-[88%] rounded-[22px] rounded-bl-md bg-white px-4 py-3 text-sm leading-6 text-slate-900 shadow-sm">
                  Перед входом в форум теперь сразу видно структуру тем и актуальную активность.
                </div>
                <div class="ml-auto max-w-[82%] rounded-[22px] rounded-br-md bg-cyan-400/15 px-4 py-3 text-sm leading-6 text-cyan-50 ring-1 ring-inset ring-cyan-200/10">
                  Уведомления, статусы и реакции теперь ощущаются одинаково собранно на iPhone, Android и в вебе.
                </div>
              </div>

              <div class="mt-5 grid grid-cols-2 gap-3">
                <div class="rounded-[20px] border border-white/5 bg-white/[0.03] px-4 py-4">
                  <div class="text-[11px] uppercase tracking-[0.16em] text-slate-500">Реакции</div>
                  <div class="mt-2 text-lg font-semibold text-white">Стабильнее</div>
                </div>
                <div class="rounded-[20px] border border-white/5 bg-white/[0.03] px-4 py-4">
                  <div class="text-[11px] uppercase tracking-[0.16em] text-slate-500">Медиа</div>
                  <div class="mt-2 text-lg font-semibold text-white">С прогрессом</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal class="reveal mt-6 rounded-[36px] border border-white/10 bg-white/[0.03] px-6 py-10 shadow-[0_18px_44px_rgba(2,6,23,0.14)] md:px-10 md:py-12 lg:px-14">
    <div class="mx-auto max-w-3xl text-center">
      <div class="text-[11px] font-medium uppercase tracking-[0.24em] text-slate-400">Установите Балалайку</div>
      <h2 class="mt-3 text-[34px] font-semibold tracking-[-0.04em] text-white md:text-[42px]">
        Приложение уже готово для команды
      </h2>
      <p class="mx-auto mt-4 max-w-[560px] text-[15px] leading-8 text-slate-300 md:text-[17px] md:leading-8">
        Выберите свою платформу и установите Балалайку через официальный каталог или TestFlight.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        {{#each installButtons}}
          <a href="{{this.href}}" target="_blank" rel="noopener noreferrer"
             class="relative inline-flex items-center justify-center rounded-[24px] border border-white/10 bg-white/[0.04] p-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-white/20 hover:bg-white/[0.07] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
             aria-label="{{this.alt}}">
            <img src="{{this.img}}" alt="{{this.alt}}" class="h-14 w-auto md:h-[58px]" />
            <span class="absolute -right-2 -top-2 rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold text-slate-900 shadow-sm">{{this.note}}</span>
          </a>
        {{/each}}
      </div>
    </div>
  </section>

  <section data-reveal class="reveal mt-14">
    <div class="max-w-[640px]">
      <div class="text-[11px] font-medium uppercase tracking-[0.24em] text-slate-400">Что нового</div>
      <h2 class="mt-3 text-[34px] font-semibold tracking-[-0.04em] text-white md:text-[42px]">
        Главное в этом обновлении
      </h2>
      <p class="mt-4 max-w-[560px] text-[15px] leading-8 text-slate-300 md:text-[17px] md:leading-8">
        Только важные изменения, которые заметны в повседневной работе.
      </p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {{#each changelogGroups}}
        <article data-reveal data-stagger="card" class="reveal rounded-[30px] border border-white/10 bg-gray-900/50 px-6 py-6 transition-colors duration-200 hover:border-white/15 hover:bg-gray-900/65 md:px-7 md:py-7">
          <h3 class="text-[28px] font-semibold tracking-[-0.04em] text-white">{{this.title}}</h3>
          <p class="mt-3 text-[15px] leading-7 text-slate-400">{{this.lead}}</p>
          <ul class="mt-6 space-y-4 text-[15px] leading-8 text-slate-300 md:text-base md:leading-8">
            {{#each this.items}}
              <li class="flex items-start gap-3">
                <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-200"></span>
                <span>{{this}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
      {{/each}}
    </div>
  </section>
</main>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 720ms cubic-bezier(0.22, 1, 0.36, 1), transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const items = Array.from(document.querySelectorAll('[data-reveal]'));
    if (!items.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const staggerItems = Array.from(document.querySelectorAll('[data-stagger="card"]'));
    staggerItems.forEach((item, index) => {
      item.style.transitionDelay = `${120 + index * 90}ms`;
    });

    items.forEach((item) => {
      if (!item.dataset.stagger) item.style.transitionDelay = '40ms';
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.16,
      rootMargin: '0px 0px -48px 0px'
    });

    items.forEach((item) => observer.observe(item));
  })();
</script>

<footer class="pb-8 pt-12 text-center text-sm text-gray-500 dark:text-gray-400">
  © 2026 Балалайка · Платоникс
</footer>
