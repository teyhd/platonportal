            <source type="image/webp" srcset="/img/balalayka/optimized/web-chat-600.webp 600w, /img/balalayka/optimized/web-chat-1080.webp 1080w" sizes="(max-width: 699px) 82vw, 52vw">
            <img src="/img/balalayka/web-chat-profile.jpg" width="1080" height="1080" alt="Веб-интерфейс Балалайки с рабочими чатами" fetchpriority="high">
          </picture>
        </figure>
        <figure class="bl-phone-shot">
          <picture>
            <source type="image/avif" srcset="/img/balalayka/optimized/ios-chat-420.avif 420w, /img/balalayka/optimized/ios-chat-768.avif 768w" sizes="(max-width: 699px) 35vw, 24vw">
            <source type="image/webp" srcset="/img/balalayka/optimized/ios-chat-420.webp 420w, /img/balalayka/optimized/ios-chat-768.webp 768w" sizes="(max-width: 699px) 35vw, 24vw">
