<div class="bl-page relative isolate overflow-x-hidden">
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="bl-ambient bl-ambient-top"></div>
    <div class="bl-ambient bl-ambient-side"></div>
    <div class="bl-grid-mask"></div>
  </div>

  <main class="relative z-10">
    <section id="hero" class="relative pt-[88px] sm:pt-[104px]">
      <div class="mx-auto grid max-w-[1320px] gap-10 px-4 pb-14 sm:px-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center lg:gap-12 lg:px-10 lg:pb-16">
        <div data-reveal class="bl-reveal relative z-10">
          <div class="inline-flex items-center gap-2 rounded-[8px] border border-white/10 bg-white/[0.04] px-4 py-2 text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted)]">
            Мессенджер Платоникс
          </div>

          <h1 class="mt-6 max-w-[760px] text-4xl font-semibold leading-[1.05] text-white sm:text-5xl lg:text-6xl">
            Командное общение без лишнего шума
          </h1>

          <p class="mt-6 max-w-[620px] text-[16px] leading-8 text-[color:var(--bl-muted)] md:text-[19px] md:leading-9">
            Обсуждайте задачи, делитесь файлами и подключайтесь к комнатам в одном сервисе: в браузере, на Android и на iPhone.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="{{openHref}}" target="_blank" rel="noopener noreferrer" class="bl-button bl-button-primary w-full sm:w-auto">
              Открыть в браузере
            </a>
            <a href="#platforms" class="bl-button bl-button-secondary w-full sm:w-auto">
              Скачать приложение
            </a>
          </div>

          <div class="mt-10 grid gap-3 sm:grid-cols-3">
            {{#each heroHighlights}}
              <div class="bl-mini-surface">
                <div class="text-[12px] uppercase tracking-[0.22em] text-[color:var(--bl-accent)]">{{this.value}}</div>
                <div class="mt-3 text-sm leading-6 text-[color:var(--bl-muted)]">{{this.label}}</div>
              </div>
            {{/each}}
          </div>
        </div>

        <div data-reveal class="bl-reveal relative lg:pl-10">
          <div id="hero-stage" class="relative mx-auto w-full max-w-[780px] min-h-[440px] sm:aspect-[1.02/1] sm:min-h-[500px]">
            <img src="/img/balalayka/icon-512.png" alt="" aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[44%] hidden h-[380px] w-[380px] -translate-x-1/2 -translate-y-1/2 opacity-[0.08] saturate-0 md:block" />

            <div class="bl-floating-chip absolute left-2 top-12 hidden md:inline-flex bl-parallax-layer" style="--depth:0.2;">
              Единый вход
            </div>
            <div class="bl-floating-chip absolute right-4 top-6 bl-parallax-layer" style="--depth:0.12;">
              Live · звонки
            </div>
            <div class="bl-floating-chip absolute bottom-16 left-10 bl-parallax-layer" style="--depth:0.16;">
              Спокойные уведомления
            </div>

            <article class="bl-browser-frame absolute inset-x-6 top-12 z-20 mx-auto max-w-[560px] bl-parallax-layer sm:inset-x-16 lg:top-10" style="--depth:0.08;">
              <div class="flex items-center justify-between border-b border-white/8 px-4 py-3 text-[11px] uppercase tracking-[0.22em] text-[color:var(--bl-muted-2)]">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-white/18"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-white/12"></span>
                </div>
                <span>msg.platoniks.ru</span>
              </div>
              <div class="relative overflow-hidden rounded-b-[24px]">
                <img src="/img/balalayka/web-chat-profile.jpg" alt="Веб-версия Балалайки" class="h-full w-full object-cover object-center" />
                <div class="bl-surface-tag absolute bottom-5 left-5">В браузере</div>
              </div>
            </article>

            <article class="bl-phone-frame absolute left-0 top-28 z-30 w-[38%] max-w-[250px] bl-parallax-layer sm:left-8 sm:top-24" style="--depth:0.22; --base-rotate:-10deg;">
              <img src="/img/balalayka/ios-chat-dark.png" alt="Интерфейс Балалайки на iPhone" class="h-full w-full object-cover object-top" />
            </article>

            <article class="bl-phone-frame bl-phone-frame-light absolute bottom-0 right-0 z-30 w-[34%] max-w-[228px] bl-parallax-layer sm:right-8 sm:w-[36%]" style="--depth:0.18; --base-rotate:9deg;">
              <img src="/img/balalayka/android-chat-light.png" alt="Интерфейс Балалайки на Android" class="h-full w-full object-cover object-top" />
            </article>

            <div class="absolute bottom-4 left-1/2 z-40 hidden -translate-x-1/2 rounded-[8px] border border-white/10 bg-black/45 px-5 py-3 text-xs uppercase tracking-[0.26em] text-[color:var(--bl-muted-2)] backdrop-blur-xl md:flex">
              iPhone · Android · браузер
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="proof" class="scroll-mt-28 border-y border-white/8 py-10 lg:py-14">
      <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-10">
        <div data-reveal class="bl-reveal">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-[720px]">
              <div class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">Удобства</div>
              <h2 class="mt-4 max-w-[760px] text-3xl font-semibold leading-[1.05] text-white md:text-5xl">
                Когда чаты, задачи и комнаты рядом, работать проще.
              </h2>
            </div>
            <p class="max-w-[430px] text-[15px] leading-7 text-[color:var(--bl-muted)]">
              Балалайка собирает переписку, файлы и быстрые созвоны в одном понятном месте.
            </p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
            {{#each proofPoints}}
              <article class="bl-proof-item">
                <h3 class="text-lg font-medium text-white">{{this.title}}</h3>
                <p class="mt-3 text-[15px] leading-7 text-[color:var(--bl-muted)]">{{this.text}}</p>
              </article>
            {{/each}}
          </div>
        </div>
      </div>
    </section>

    <section id="showcase" class="scroll-mt-28 py-16 lg:py-24">
      <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-10">
        <div data-reveal class="bl-reveal max-w-[780px]">
          <div class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">Сценарии</div>
          <h2 class="mt-4 max-w-[780px] text-3xl font-semibold leading-[1.05] text-white md:text-5xl">
            Переписка, файлы и комнаты без лишних переключений.
          </h2>
          <p class="mt-5 max-w-[620px] text-[16px] leading-8 text-[color:var(--bl-muted)]">
            Выберите сценарий и посмотрите, как Балалайка помогает в обычной работе команды.
          </p>
        </div>

        <div data-reveal class="bl-reveal mt-10">
          <div class="no-scrollbar flex gap-2 overflow-x-auto rounded-[8px] border border-white/10 bg-white/[0.03] p-2" role="tablist" aria-label="Сценарии продукта">
            {{#each showcaseItems}}
              <button
                type="button"
                role="tab"
                aria-selected="{{#if @first}}true{{else}}false{{/if}}"
                aria-controls="showcase-{{this.id}}"
                id="showcase-tab-{{this.id}}"
                data-showcase-trigger="{{this.id}}"
                class="bl-showcase-tab {{#if @first}}is-active{{/if}}">
                {{this.label}}
              </button>
            {{/each}}
          </div>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,0.76fr)_minmax(0,1.24fr)] lg:items-center">
          <div class="order-2 lg:order-1">
            <div class="relative min-h-[280px] sm:min-h-[260px] lg:min-h-[340px]">
              {{#each showcaseItems}}
                <article
                  id="showcase-copy-{{this.id}}"
                  data-showcase-copy="{{this.id}}"
                  class="bl-showcase-copy {{#if @first}}is-active{{/if}}"
                  aria-labelledby="showcase-tab-{{this.id}}">
                  <div class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-accent)]">{{this.eyebrow}}</div>
                  <h3 class="mt-4 max-w-[620px] text-3xl font-semibold leading-[1.05] text-white md:text-4xl">
                    {{this.title}}
                  </h3>
                  <p class="mt-5 max-w-[560px] text-[16px] leading-8 text-[color:var(--bl-muted)]">
                    {{this.description}}
                  </p>
                  <ul class="mt-8 space-y-4">
                    {{#each this.points}}
                      <li class="flex items-start gap-3 text-[15px] leading-7 text-[color:var(--bl-text-soft)]">
                        <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[color:var(--bl-accent)]"></span>
                        <span>{{this}}</span>
                      </li>
                    {{/each}}
                  </ul>
                </article>
              {{/each}}
            </div>
          </div>

          <div class="order-1 lg:order-2">
            <div class="relative h-[440px] sm:h-[520px] lg:h-[620px]">
              {{#each showcaseItems}}
                <section
                  id="showcase-{{this.id}}"
                  role="tabpanel"
                  aria-labelledby="showcase-tab-{{this.id}}"
                  data-showcase-visual="{{this.id}}"
                  class="bl-showcase-visual {{#if @first}}is-active{{/if}}">

                  {{#if (eq this.id 'forums')}}
                    <div class="bl-stage-panel">
                      <div class="flex items-center justify-between border-b border-white/8 px-5 py-4">
                        <div>
                          <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Задачи</div>
                          <div class="mt-1 text-lg font-medium text-white">Задачи команды</div>
                        </div>
                        <div class="rounded-[6px] border border-[color:var(--bl-accent-edge)] bg-[color:var(--bl-accent-soft)] px-3 py-1 text-xs uppercase tracking-[0.22em] text-[color:var(--bl-accent)]">
                          14 активных задач
                        </div>
                      </div>
                      <div class="space-y-3 p-5">
                        <div class="flex gap-2 text-xs uppercase tracking-[0.2em] text-[color:var(--bl-muted-2)]">
                          <span class="rounded-[6px] border border-white/10 bg-white/[0.06] px-3 py-2 text-white">Все задачи</span>
                          <span class="rounded-[6px] border border-white/8 px-3 py-2">Дизайн</span>
                          <span class="rounded-[6px] border border-white/8 px-3 py-2">Релиз</span>
                        </div>
                        <div class="bl-topic-item">
                          <span class="bl-topic-icon">З</span>
                          <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                              <span class="truncate text-base font-medium text-white">Подготовить релиз</span>
                              <span class="text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">только что</span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">В описании собраны сроки, контекст и последние комментарии по задаче.</p>
                          </div>
                        </div>
                        <div class="bl-topic-item">
                          <span class="bl-topic-icon bl-topic-icon-muted">R</span>
                          <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                              <span class="truncate text-base font-medium text-white">Проверить релиз 4.2</span>
                              <span class="text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">12 мин</span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">Статус, ответственный и новые сообщения видны прямо в списке задач.</p>
                          </div>
                        </div>
                        <div class="bl-topic-item">
                          <span class="bl-topic-icon bl-topic-icon-accent">L</span>
                          <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                              <span class="truncate text-base font-medium text-white">Созвон по запуску</span>
                              <span class="text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">через 10 мин</span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">Позвонить команде можно прямо из карточки, не теряя контекст обсуждения.</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  {{/if}}

                  {{#if (eq this.id 'reactions')}}
                    <div class="bl-stage-panel">
                      <div class="flex items-center justify-between px-5 py-4">
                        <div class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">Реакции и быстрый ответ</div>
                        <div class="text-xs uppercase tracking-[0.12em] text-[color:var(--bl-accent)]">готово</div>
                      </div>
                      <div class="space-y-4 px-5 pb-5">
                        <div class="bl-chat-bubble bl-chat-bubble-out">
                          Согласовано. Запускаем после вечерней проверки.
                        </div>
                        <div class="bl-chat-bubble bl-chat-bubble-in">
                          Тогда переношу встречу на 18:30 и закреплю в теме.
                        </div>
                        <div class="rounded-[8px] border border-white/8 bg-black/35 p-4">
                          <div class="flex items-center justify-between gap-4">
                            <div class="flex items-center gap-2">
                              <span class="bl-reaction">👍 18</span>
                              <span class="bl-reaction bl-reaction-accent">🔥 7</span>
                              <span class="bl-reaction">✅ 12</span>
                            </div>
                            <span class="text-xs uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">быстрые реакции</span>
                          </div>
                          <div class="mt-4 flex flex-wrap gap-2">
                            <span class="bl-emoji-pill bl-emoji-burst">👏</span>
                            <span class="bl-emoji-pill">💡</span>
                            <span class="bl-emoji-pill">⚡</span>
                            <span class="bl-emoji-pill">🎯</span>
                            <span class="bl-emoji-pill">🫶</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  {{/if}}

                  {{#if (eq this.id 'media')}}
                    <div class="bl-stage-panel">
                      <div class="grid h-full gap-4 p-5 lg:grid-cols-[1.06fr_0.94fr]">
                        <div class="rounded-[8px] border border-white/8 bg-white/[0.03] p-4">
                          <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Видео и фото</div>
                          <div class="mt-4 overflow-hidden rounded-[6px] border border-white/8 bg-[radial-gradient(circle_at_top,_rgba(212,171,98,0.22),_rgba(15,15,18,0.95)_58%)]">
                            <div class="aspect-[1.16/1] bg-[linear-gradient(135deg,_rgba(255,255,255,0.03),_rgba(255,255,255,0))]"></div>
                          </div>
                          <div class="mt-4 space-y-3">
                            <div class="flex items-center justify-between text-sm text-[color:var(--bl-text-soft)]">
                              <span>Презентация квартала.mp4</span>
                              <span>84%</span>
                            </div>
                            <div class="bl-progress-track">
                              <span class="bl-progress-fill"></span>
                            </div>
                            <div class="flex items-center justify-between text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">
                              <span>виден прогресс</span>
                              <span>можно вернуться позже</span>
                            </div>
                          </div>
                        </div>
                        <div class="flex flex-col gap-4">
                          <div class="rounded-[8px] border border-white/8 bg-white/[0.03] p-4">
                            <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Документы</div>
                            <div class="mt-4 rounded-[6px] border border-[color:var(--bl-accent-edge)] bg-[color:var(--bl-accent-soft)] p-4">
                              <div class="text-base font-medium text-white">Материалы обсуждения</div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">Презентации, документы и заметки удобно открыть повторно прямо из чата.</p>
                            </div>
                          </div>
                          <div class="rounded-[8px] border border-white/8 bg-black/35 p-4">
                            <div class="flex items-center justify-between">
                              <div class="text-base font-medium text-white">Альбом команды</div>
                              <div class="text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">12 файлов</div>
                            </div>
                            <div class="mt-4 grid grid-cols-3 gap-2">
                              <div class="aspect-square rounded-[6px] bg-white/[0.07]"></div>
                              <div class="aspect-square rounded-[6px] bg-white/[0.05]"></div>
                              <div class="aspect-square rounded-[6px] bg-[color:var(--bl-accent-soft)]"></div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {{/if}}

                  {{#if (eq this.id 'notifications')}}
                    <div class="bl-stage-panel">
                      <div class="space-y-3 p-5">
                        <div class="flex items-center justify-between">
                          <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Уведомления</div>
                          <div class="rounded-[6px] border border-white/8 px-3 py-1 text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted)]">не отвлекает</div>
                        </div>
                        <div class="bl-notification-card">
                          <div class="bl-notification-mark"></div>
                          <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                              <span class="truncate text-sm font-medium text-white">Умные уведомления</span>
                              <span class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">важно</span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">Уведомление выглядит одинаково на iPhone, Android и в браузере.</p>
                          </div>
                        </div>
                        <div class="bl-notification-card bl-notification-card-offset">
                          <div class="bl-notification-mark bl-notification-mark-accent"></div>
                          <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                              <span class="truncate text-sm font-medium text-white">Проект “Релиз”</span>
                              <span class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">новое</span>
                            </div>
                            <p class="mt-2 text-sm leading-6 text-[color:var(--bl-muted)]">Когда чат уже открыт, лишние уведомления не мешают.</p>
                          </div>
                        </div>
                        <div class="rounded-[8px] border border-white/8 bg-black/35 px-4 py-4">
                          <div class="flex items-center justify-between">
                            <span class="text-sm text-[color:var(--bl-text-soft)]">Спокойный режим</span>
                            <span class="rounded-[6px] border border-[color:var(--bl-accent-edge)] bg-[color:var(--bl-accent-soft)] px-2 py-1 text-[11px] uppercase tracking-[0.18em] text-[color:var(--bl-accent)]">включены</span>
                          </div>
                          <div class="mt-4 grid gap-3 sm:grid-cols-2">
                            <div class="rounded-[6px] border border-white/8 bg-white/[0.04] px-3 py-3 text-sm text-[color:var(--bl-muted)]">Сообщения в активном чате</div>
                            <div class="rounded-[6px] border border-white/8 bg-white/[0.04] px-3 py-3 text-sm text-[color:var(--bl-muted)]">Важные уведомления</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {{/if}}

                  {{#if (eq this.id 'live')}}
                    <div class="bl-stage-panel">
                      <div class="grid h-full gap-4 p-5 lg:grid-cols-[0.95fr_1.05fr]">
                        <div class="rounded-[8px] border border-white/8 bg-white/[0.03] p-4">
                          <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Комнаты</div>
                          <div class="mt-4 space-y-3">
                            <div class="bl-room-item">
                              <span class="bl-room-dot"></span>
                              <div class="flex-1">
                                <div class="text-sm font-medium text-white">Продуктовая синхронизация</div>
                                <div class="mt-1 text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">18 участников</div>
                              </div>
                            </div>
                            <div class="bl-room-item">
                              <span class="bl-room-dot bl-room-dot-muted"></span>
                              <div class="flex-1">
                                <div class="text-sm font-medium text-white">Форум дизайна</div>
                                <div class="mt-1 text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">Тема закреплена</div>
                              </div>
                            </div>
                            <div class="bl-room-item">
                              <span class="bl-room-dot bl-room-dot-accent"></span>
                              <div class="flex-1">
                                <div class="text-sm font-medium text-white">Комната релиза</div>
                                <div class="mt-1 text-xs uppercase tracking-[0.18em] text-[color:var(--bl-muted-2)]">Старт через 12 мин</div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="rounded-[8px] border border-[color:var(--bl-accent-edge)] bg-[linear-gradient(180deg,_rgba(212,171,98,0.12),_rgba(12,12,16,0.82)_44%,_rgba(12,12,16,0.96)_100%)] p-4">
                          <div class="flex items-center justify-between">
                            <div>
                              <div class="text-[11px] uppercase tracking-[0.24em] text-[color:var(--bl-muted-2)]">Live</div>
                              <div class="mt-1 text-lg font-medium text-white">Команда внутри одного обсуждения</div>
                            </div>
