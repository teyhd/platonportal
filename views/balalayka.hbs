      <div class="bl-platform-actions">
        <a href="{{openHref}}" target="_blank" rel="noopener noreferrer" data-analytics-event="platform_web"><span>Веб-версия</span><small>Без установки</small><b>Открыть <span aria-hidden="true">↗</span></b></a>
