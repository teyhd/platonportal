          <img src="/img/balalayka/icon-512.png" alt="" aria-hidden="true" class="pointer-events-none absolute right-[-44px] top-1/2 hidden h-[260px] w-[260px] -translate-y-1/2 opacity-[0.07] saturate-0 lg:block" />

          <div class="relative max-w-[760px]">
            <div class="text-[11px] uppercase tracking-[0.12em] text-[color:var(--bl-muted-2)]">Открыть Балалайку</div>
            <h2 class="mt-4 max-w-[760px] text-3xl font-semibold leading-[1.05] text-white md:text-5xl">
