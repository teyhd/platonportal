        <div class="bl-hero-actions" aria-label="Открыть Балалайку">
          <a class="bl-button bl-button-primary" href="{{openHref}}" target="_blank" rel="noopener noreferrer" data-device-primary data-analytics-event="hero_web_open">Открыть веб-версию</a>
          <a class="bl-button bl-button-secondary" href="{{iosHref}}" target="_blank" rel="noopener noreferrer" data-device-secondary data-analytics-event="hero_ios_install">iPhone в TestFlight</a>
