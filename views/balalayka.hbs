                Скачать на телефон
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="relative z-10 border-t border-white/8 pb-8 pt-6">
    <div class="mx-auto flex max-w-[1320px] flex-col gap-4 px-4 text-sm text-[color:var(--bl-muted)] sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-10">
