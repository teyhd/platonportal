<div class="container" style="max-width: 900px; margin-top: 24px;">
  <h3 style="margin-bottom: 18px;">Конфигурация: загрузка файлов</h3>

  {{#if canUpload}}
  <div class="card" style="padding:16px; border-radius:12px; border:1px solid #e5e7eb;">
    <p style="margin:0 0 12px 0; color:#334155;">Загрузить файл в <code>/public/conf</code></p>
    <input id="fileInput" type="file" />
    <button id="uploadBtn" style="margin-left:10px;">Загрузить</button>
    <div id="status" style="margin-top:10px; color:#0f172a;"></div>
  </div>
  {{else}}
  <div class="card" style="padding:16px; border-radius:12px; border:1px solid #fee2e2; background:#fff1f2; color:#9f1239;">
    Недостаточно прав для загрузки файлов.
  </div>
  {{/if}}

  <h4 style="margin-top:24px;">Файлы</h4>
  {{#if files.length}}
    <ul style="line-height:1.8;">
      {{#each files}}
        <li>
          <a href="{{this.url}}" target="_blank" rel="noopener">{{this.name}}</a>
          <span style="color:#64748b;">(обновлён: {{this.mtime}})</span>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p style="color:#64748b;">Пока нет файлов.</p>
  {{/if}}
</div>

{{#if canUpload}}
<script>
(() => {
  const input = document.getElementById('fileInput');
  const btn = document.getElementById('uploadBtn');
  const status = document.getElementById('status');
  if (!input || !btn) return;

  btn.addEventListener('click', async () => {
    const file = input.files?.[0];
    if (!file) {
      status.textContent = 'Выбери файл';
      return;
    }

    if (file.size > 15 * 1024 * 1024) {
      status.textContent = 'Файл слишком большой (макс 15 МБ)';
      return;
    }

    status.textContent = 'Загрузка...';

    const reader = new FileReader();
    reader.onload = async () => {
      try {
        const dataUrl = String(reader.result || '');
        const base64 = dataUrl.split(',')[1] || '';
        const res = await fetch('/api/conf/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            filename: file.name,
            mimeType: file.type || 'application/octet-stream',
            contentBase64: base64
          })
        });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error(json.message || 'Upload failed');
        status.innerHTML = `Готово: <a href="${json.url}" target="_blank" rel="noopener">${json.url}</a>`;
        setTimeout(() => location.reload(), 700);
      } catch (e) {
        status.textContent = 'Ошибка: ' + (e.message || e);
      }
    };
    reader.readAsDataURL(file);
  });
})();
</script>
{{/if}}
