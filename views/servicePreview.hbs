<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{service.label}} · Аудит доступа</title>
  <link rel="stylesheet" href="/css/user-family-tools.css?v=3">
</head>
<body class="users-preview-page">
  <main>
    <header>
      <p class="users-preview-badge">Аудит доступа · Только просмотр</p>
      <h1>{{service.label}}</h1>
      <p>{{target.name}} · ID {{target.id}}</p>
      {{#if selected}}<p>Ребёнок — {{selected.name}} · ID {{selected.id}}</p>{{/if}}
    </header>
    <section aria-labelledby="audit-roles">
      <h2 id="audit-roles">Назначенные роли</h2>
      <ul class="users-preview-roles">
        {{#each service.roles}}<li>{{this}}</li>{{/each}}
      </ul>
    </section>
    {{#if hasSummary}}
    <section aria-labelledby="audit-summary">
      <h2 id="audit-summary">Сводка сервиса</h2>
      {{#if snapshot.date}}<p>Дата сводки — {{snapshot.date}}</p>{{/if}}
      {{#if snapshot.entries}}
        <ul class="users-family-list">
          {{#each snapshot.entries}}
            <li><div class="users-family-record">
              <strong>{{title}}</strong>
              {{#if detail}}<small>{{detail}}</small>{{/if}}
            </div></li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if message}}<p>{{message}}</p>{{/if}}
    </section>
    {{else}}
      <p>{{message}}</p>
    {{/if}}
  </main>
</body>
</html>
