<main class="min-h-screen bg-[#f5f5f7] text-slate-950">
  <div class="mx-auto max-w-[1500px] px-[16px] pb-10 pt-14 sm:pt-16 md:px-6 xl:pt-16">
    <header class="max-w-4xl">
      {{#unless isGuestHome}}
        <h1 class="text-3xl font-semibold leading-tight tracking-tight text-slate-950 md:text-4xl xl:text-5xl">
          {{homeTitle}}
        </h1>
      {{/unless}}
    </header>

    {{#if operationMenu.length}}
      <section id="lesson-room-panel" data-lesson-room-panel data-auth="{{auth}}"
               class="mt-5 rounded-lg border border-slate-200 bg-white p-4 shadow-sm shadow-slate-950/5 sm:mt-6 md:p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-base font-semibold text-blue-700 md:text-lg">Уроки и комнаты</p>
            <h2 class="mt-2 text-2xl font-semibold leading-tight tracking-tight text-slate-950 md:text-3xl">
              Быстро подключиться к уроку
            </h2>
          </div>
          <div class="shrink-0 rounded-lg border border-emerald-100 bg-emerald-50 px-3 py-2 text-center text-emerald-950 md:px-4 md:py-3">
            <div class="text-xs font-semibold text-emerald-700 md:text-sm">сейчас</div>
            <div data-lesson-time class="mt-1 text-base font-semibold md:text-lg">--:--</div>
          </div>
        </div>

        <div class="mt-4 grid gap-3 md:mt-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_14rem]">
          {{#each operationMenu}}
            <a href="{{this.cont}}"
               class="group flex min-h-[112px] items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3 transition hover:-translate-y-0.5 hover:border-blue-300 hover:bg-white hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20 md:min-h-[132px] md:gap-5 md:p-5">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-slate-950 p-2 shadow-sm shadow-slate-950/20 md:h-16 md:w-16">
                <img src="{{this.imageSrc}}" alt="" class="h-full w-full object-contain" loading="lazy" />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-blue-700">{{this.kindLabel}}</span>
                <span class="mt-1 block text-lg font-semibold leading-6 text-slate-950 line-clamp-2 md:text-2xl md:leading-8">{{this.title}}</span>
                <span class="mt-2 block text-sm leading-6 text-slate-600 line-clamp-2 md:text-base md:leading-7">{{this.summary}}</span>
              </span>
            </a>
          {{/each}}

          <div class="rounded-lg border border-slate-200 bg-white p-4 lg:min-h-[132px]">
            <div class="text-sm font-semibold text-slate-500">Открытые комнаты</div>
            <div data-open-rooms-count class="mt-3 text-3xl font-semibold leading-none text-slate-950">0</div>
          </div>
        </div>
      </section>
    {{/if}}

    <section class="mt-6" aria-labelledby="services-title">
      <h2 id="services-title" class="text-2xl font-semibold tracking-tight text-slate-950 md:text-3xl">
        Приложения и сервисы
      </h2>

      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6">
        {{#if isGuestHome}}
          <button type="button" data-open-login
                  class="group flex min-h-[148px] flex-col items-center justify-center rounded-lg border border-blue-200 bg-white p-3 text-center shadow-sm shadow-blue-950/5 transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20 sm:min-h-[156px] md:min-h-[168px] md:p-4 xl:min-h-[176px]">
            <span class="flex h-[76px] w-[76px] items-center justify-center rounded-lg bg-blue-600 text-white shadow-sm shadow-blue-950/20 sm:h-20 sm:w-20 md:h-24 md:w-24 xl:h-28 xl:w-28">
              <svg class="h-9 w-9 sm:h-10 sm:w-10 md:h-12 md:w-12 xl:h-14 xl:w-14" aria-hidden="true"><use href="/icons/lucide.svg#log-in"></use></svg>
            </span>
            <span class="mt-3 block text-base font-semibold leading-6 text-slate-950">Войти по PIN</span>
            <span class="mt-1.5 inline-flex items-center gap-1 text-sm font-semibold text-blue-600">
              Открыть
              <svg class="h-4 w-4 transition group-hover:translate-x-0.5" aria-hidden="true"><use href="/icons/lucide.svg#arrow-right"></use></svg>
            </span>
          </button>
        {{/if}}

        {{#each catalogServices}}
          <a href="{{this.cont}}"
             class="group flex min-h-[148px] flex-col items-center justify-center rounded-lg border border-slate-200 bg-white p-3 text-center shadow-sm shadow-slate-950/5 transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20 sm:min-h-[156px] md:min-h-[168px] md:p-4 xl:min-h-[176px]">
            <span class="flex h-[76px] w-[76px] items-center justify-center rounded-lg border border-slate-200 bg-slate-50 p-3 sm:h-20 sm:w-20 md:h-24 md:w-24 md:p-4 xl:h-28 xl:w-28">
              <img src="{{this.imageSrc}}" alt="" class="h-full w-full object-contain" loading="lazy" />
            </span>
            <span class="mt-3 block text-base font-semibold leading-6 text-slate-950 line-clamp-2">{{this.title}}</span>
          </a>
        {{/each}}
      </div>
    </section>

    {{#if infoGroup.hasItems}}
      <section class="mt-8" aria-labelledby="info-title">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-blue-700">Для родителей</p>
          <h2 id="info-title" class="mt-1 text-2xl font-semibold tracking-tight text-slate-950 md:text-3xl">
            Важное о школе
          </h2>
          <p class="mt-2 text-sm leading-6 text-slate-600 md:text-base">
            Учебный график, администрация, соцсети и материалы, которые чаще всего нужны семье.
          </p>
        </div>

        {{#if infoGroup.hasPrimaryItems}}
          <div class="mt-4 grid gap-3 lg:grid-cols-3">
            {{#each infoGroup.primaryItems}}
              <article class="rounded-lg border p-4 shadow-sm {{this.cardClass}}" data-info-card>
                <div class="flex items-start gap-3">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border {{this.iconClass}}">
                    <svg class="h-5 w-5" aria-hidden="true"><use href="/icons/lucide.svg#{{this.iconName}}"></use></svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] {{this.badgeClass}}">{{this.audienceLabel}}</p>
                    <h3 class="mt-1 text-xl font-semibold leading-6 text-slate-950">{{this.title}}</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{{this.parentSummary}}</p>
                  </div>
                </div>

                <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700" data-info-preview>
                  {{#each this.previewLines}}
                    <li class="border-t border-slate-200/70 pt-2">{{{this.html}}}</li>
                  {{/each}}
                </ul>
                {{#if this.hasMoreLines}}
                  <div class="mt-2 hidden border-t border-slate-200/70 pt-2" data-info-full>
                    <ul class="space-y-2 text-sm leading-6 text-slate-700">
                      {{#each this.fullLines}}
                        <li>{{{this.html}}}</li>
                      {{/each}}
                    </ul>
                  </div>
                  <button type="button" data-info-toggle aria-expanded="false"
                          class="mt-3 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white/80 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/30">
                    <span data-info-toggle-label>Показать полностью</span>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">+{{this.moreLinesCount}}</span>
                    <svg data-info-toggle-icon class="h-4 w-4 transition-transform" aria-hidden="true"><use href="/icons/lucide.svg#chevron-down"></use></svg>
                  </button>
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{/if}}

        {{#if infoGroup.hasSecondaryItems}}
          <div class="mt-6 flex items-center justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold tracking-tight text-slate-950">Еще полезно</h3>
              <p class="mt-1 text-sm text-slate-500">Короткие памятки; если текст длинный, его можно раскрыть.</p>
            </div>
          </div>

          <div class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            {{#each infoGroup.secondaryItems}}
              <article class="rounded-lg border p-4 shadow-sm transition hover:border-slate-300 hover:shadow-md {{this.cardClass}}" data-info-card>
                <div class="flex items-start gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border {{this.iconClass}}">
                    <svg class="h-5 w-5" aria-hidden="true"><use href="/icons/lucide.svg#{{this.iconName}}"></use></svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] {{this.badgeClass}}">{{this.audienceLabel}}</p>
                    <h3 class="mt-1 text-lg font-semibold leading-6 text-slate-950 line-clamp-2">{{this.title}}</h3>
                  </div>
                </div>

                <ul class="mt-3 space-y-1.5 text-sm leading-6 text-slate-600" data-info-preview>
                  {{#each this.previewLines}}
                    <li>{{{this.html}}}</li>
                  {{/each}}
                </ul>
                {{#if this.hasMoreLines}}
                  <div class="mt-3 hidden border-t border-slate-200 pt-3" data-info-full>
                    <ul class="space-y-1.5 text-sm leading-6 text-slate-600">
                      {{#each this.fullLines}}
                        <li>{{{this.html}}}</li>
                      {{/each}}
                    </ul>
                  </div>
                  <button type="button" data-info-toggle aria-expanded="false"
                          class="mt-3 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/30">
                    <span data-info-toggle-label>Показать полностью</span>
                    <span class="rounded-full bg-white px-2 py-0.5 text-xs text-slate-500">+{{this.moreLinesCount}}</span>
                    <svg data-info-toggle-icon class="h-4 w-4 transition-transform" aria-hidden="true"><use href="/icons/lucide.svg#chevron-down"></use></svg>
                  </button>
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/if}}
  </div>
</main>

<script>
(() => {
  document.querySelectorAll('[data-info-toggle]').forEach((button) => {
    const card = button.closest('[data-info-card]');
    const preview = card?.querySelector('[data-info-preview]');
    const full = card?.querySelector('[data-info-full]');
    const label = button.querySelector('[data-info-toggle-label]');
    const icon = button.querySelector('[data-info-toggle-icon]');

    if (!card || !preview || !full || !label) return;

    button.addEventListener('click', () => {
      const shouldExpand = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(shouldExpand));
      preview.classList.toggle('hidden', shouldExpand);
      full.classList.toggle('hidden', !shouldExpand);
      label.textContent = shouldExpand ? 'Свернуть' : 'Показать полностью';
      icon?.classList.toggle('rotate-180', shouldExpand);
    });
  });
})();

(() => {
  const panel = document.querySelector('[data-lesson-room-panel]');
  if (!panel) return;

  const timeEl = panel.querySelector('[data-lesson-time]');
  const roomsCountEl = panel.querySelector('[data-open-rooms-count]');

  function updateTime() {
    if (!timeEl) return;
    timeEl.textContent = new Intl.DateTimeFormat('ru-RU', {
      hour: '2-digit',
      minute: '2-digit',
    }).format(new Date());
  }

  async function updateRoomsCount() {
    if (!roomsCountEl || Number(panel.dataset.auth || 0) < 1) return;

    try {
      const response = await fetch('/rooms', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;

      const data = await response.json();
      const rooms = Array.isArray(data.rooms) ? data.rooms : [];
      const openRooms = rooms.filter((room) => {
        const id = room?.room_info?.room_id;
        return Boolean(id) && String(data?.acc?.[id]?.pub).toLowerCase() === 'true';
      });
      roomsCountEl.textContent = String(openRooms.length);
    } catch (error) {
      console.error(error);
    }
  }

  updateTime();
  updateRoomsCount();
  window.setInterval(updateTime, 30000);
})();
</script>
