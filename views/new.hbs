  <main class="pt-8 px-4 max-w-7xl mx-auto space-y-8">

    <!-- Services -->
    <section>
      <h2 class="mb-6 text-2xl font-semibold text-white" hidden>Сервисы</h2>
      <div class="grid gap-6 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        {{#each menu}}
          <a href="{{this.cont}}" class="flex flex-col items-center justify-center p-6 min-h-[160px] rounded-2xl bg-gray-800 hover:bg-gray-700 text-white shadow-lg transition-all duration-200 ease-in-out transform hover:-translate-y-1 hover:shadow-xl group text-center">
            <img src="/img/{{this.pic}}" alt="{{this.title}}" class="w-25 h-25 mb-4 transition-transform duration-200 group-hover:scale-110" />
            <span class="text-base font-medium group-hover:underline">{{this.title}}</span>
          </a>
        {{/each}}
      </div>
    </section>

    <!-- Balalayka App CTA -->
    <section class="rounded-2xl bg-gradient-to-r from-[#3e2f70] via-[#5b45a4] to-[#7c5cf0] p-[1px] shadow-2xl">
      <div class="rounded-2xl bg-gray-900/95 px-6 py-5 md:px-8 md:py-6 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/20">
            <span class="text-white font-bold tracking-tight text-sm">B</span>
          </div>
          <div>
            <h2 class="text-white text-xl md:text-2xl font-semibold leading-tight">Мессенджер Балалайка</h2>
            <p class="text-indigo-100/90 text-sm md:text-base">Установите приложение из RuStore или следите за появлением версии в App Store</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a href="https://www.rustore.ru/catalog/app/ru.platoniks.balalaika" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3
                    bg-gradient-to-r from-indigo-500 to-violet-500 hover:from-indigo-400 hover:to-violet-400
                    text-white font-semibold shadow-lg transition-all duration-200 hover:-translate-y-0.5">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-white/20 text-xs font-bold">R</span>
            <span>Скачать с RuStore</span>
          </a>

          <button type="button" disabled
             class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3
                    bg-gray-700/70 text-gray-300 font-semibold shadow-inner ring-1 ring-white/10
                    cursor-not-allowed opacity-80">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-md bg-gray-600 text-xs font-bold"></span>
            <span>Скачать в App Store (скоро)</span>
          </button>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4">
      <h2 class="mb-6 text-2xl font-semibold text-white text-center">Информация</h2>

      <!-- 📱 Аккордеон (≤ lg) -->
      <div class="space-y-4 lg:hidden">
        {{#each info}}
          <details class="group bg-gray-800 hover:bg-gray-700 rounded-xl p-4 text-white">
            <summary class="flex items-center gap-3 cursor-pointer list-none select-none">
              <!-- иконка -->
              {{#if this.icon}}
                <img src="/icons/{{this.icon}}" alt="icon" class="w-6 h-6 shrink-0">
              {{else}}
                <span class="w-6 h-6 flex items-center justify-center shrink-0">🛈</span>
              {{/if}}

              <h3 class="text-lg font-semibold">{{this.title}}</h3>

              <!-- стрелка -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  class="ml-auto w-4 h-4 transition-transform duration-300 group-open:rotate-180">
                <path fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.112l3.71-3.88a.75.75 0 1 1 1.08 1.04l-4.24 4.42a.75.75 0 0 1-1.08 0L5.25 8.27a.75.75 0 0 1-.02-1.06z"
                      clip-rule="evenodd"/>
              </svg>
            </summary>

            <div class="mt-2 text-sm text-gray-300 whitespace-pre-line">{{{this.cont}}}</div>
          </details>
        {{/each}}
      </div>

      <!-- 💻 Masonry-разметка (≥ lg) -->
      <div class="hidden lg:block columns-1 md:columns-2 xl:columns-3 gap-x-6 space-y-6">
        {{#each info}}
          <article class="break-inside-avoid bg-gray-800 hover:bg-gray-700 transition-colors
                          rounded-xl shadow-lg text-white p-6 flex flex-col gap-2 relative group">
            <header class="flex items-center gap-3 mb-2">
              {{#if this.icon}}
                <img src="/icons/{{this.icon}}" alt="icon" class="w-6 h-6 shrink-0">
              {{else}}
                <span class="w-6 h-6 flex items-center justify-center shrink-0">🛈</span>
              {{/if}}
              <h3 class="text-lg font-semibold leading-tight">{{this.title}}</h3>
            </header>

            <div class="text-sm text-gray-300 whitespace-pre-line leading-relaxed
                        max-h-52 overflow-hidden lg:max-h-none lg:line-clamp-8 lg:group-hover:line-clamp-none">
              {{{this.cont}}}
            </div>

            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-10
                        bg-gradient-to-t from-gray-800 to-transparent
                        opacity-0 lg:opacity-100 group-hover:opacity-0 transition"></div>
          </article>
        {{/each}}
      </div>
    </section>

  </main>

  <footer class="mt-16 py-6 text-center text-sm text-gray-500 dark:text-gray-400">
    © 2025 Гармония образования
  </footer>


