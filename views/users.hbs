  .users-page-grid{display:grid;min-width:0;grid-template-columns:minmax(0,1fr);gap:1.5rem}
  @media (min-width:1280px){.users-page-grid{grid-template-columns:minmax(0,320px) minmax(0,1fr)}}
  .users-table{width:100%;min-width:42rem;table-layout:fixed}
  .users-col-name{width:auto}
  .users-col-kaf{width:7rem}
  .users-col-role{width:6rem}
  .users-col-status{width:6.5rem}
  .users-col-pin{width:4.75rem}
  .users-col-actions{width:8.8rem}
  .users-th{padding:.48rem .55rem;font-size:.72rem;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.025em;white-space:nowrap}
  .users-td{padding:.38rem .55rem;vertical-align:middle;overflow:hidden}
  .user-meta-line,.user-email-line,.user-kaf-cell,.user-pin-cell,.users-badge{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .user-name-text,.user-meta-line{line-height:1.18}
  .users-table th:last-child,.users-table td:last-child{position:sticky;right:0;background:#111827;z-index:1}
  .users-table thead th:last-child{background:#111827;z-index:2}
  .users-table td:last-child{box-shadow:-10px 0 14px rgba(17,24,39,.78)}
  .users-actions{display:flex;width:100%;justify-content:flex-end;gap:.2rem;flex-wrap:nowrap}
  .action-btn{display:inline-flex;flex:0 0 1.75rem;width:1.75rem;height:1.75rem;align-items:center;justify-content:center;border:1px solid transparent;border-radius:.45rem;background:transparent;color:#d1d5db;transition:background-color .15s ease,border-color .15s ease,color .15s ease,transform .15s ease;touch-action:manipulation}
  .action-btn:hover{border-color:rgba(75,85,99,.45);background:rgba(31,41,55,.42);color:#fff}
  .action-btn:active{transform:translateY(1px)}
  .action-btn:focus-visible{outline:none;box-shadow:0 0 0 2px rgba(129,140,248,.55)}
  .action-btn svg{width:1rem;height:1rem;pointer-events:none}
  .action-btn-danger{color:#fb7185}
  .action-btn-danger:hover{border-color:rgba(244,63,94,.35);color:#fda4af;background:rgba(127,29,29,.22)}
  @media (max-width:639px){.users-table{min-width:39rem}.users-col-kaf{width:5.4rem}.users-col-role{width:5.4rem}.users-col-status{width:5.8rem}.users-col-pin{width:4.4rem}.users-col-actions{width:8rem}.users-th,.users-td{padding:.38rem .35rem}}
  .tab-btn[data-active="true"]{background:#4f46e5;color:#fff}
  .tab-panel.hidden{display:none}
</style>

{{!-- Minimal client-side behavior (no framework) --}}
<script>
/* ===== Utilities ===== */
const qs  = (s, r=document) => r.querySelector(s);
const qsa = (s, r=document) => [...r.querySelectorAll(s)];
const api = (url, opts={}) => fetch(url, { headers:{'Content-Type':'application/json'}, ...opts });

/* ===== Constants (type labels from <select>) ===== */
const TYPE_LABELS = (() => {
  const map = {};
  qsa('#filter-type option').forEach(o => {
    if (o.value !== '') map[o.value] = o.textContent.trim();
  });
  return map;
})();

const KAF_LABELS = (() => {
  const map = {};
  qsa('#f-kaf option').forEach(o => {
    if (o.value !== '') map[o.value] = o.textContent.trim();
  });
  return map;
})();

/* ===== Drawer: user editor ===== */
const userDrawer   = qs('#user-drawer');
const userBackdrop = qs('[data-backdrop]', userDrawer);
const userPanel    = userBackdrop?.nextElementSibling;

const setDrawerOpen = (open) => {
  userDrawer.classList.toggle('hidden', !open);
  requestAnimationFrame(() => {
    userBackdrop.style.opacity = open ? '1' : '0';
    userPanel.style.transform  = open ? 'translateX(0)' : 'translateX(100%)';
  });
};

const setTab = (name) => {
  qsa('.tab-btn', userDrawer).forEach(b => b.setAttribute('data-active', b.dataset.tab === name));
  qsa('.tab-panel', userDrawer).forEach(p => p.classList.toggle('hidden', p.id !== 'tab-' + name));
};

const toast = (msg, ok=true) => {
  const t = qs('#drawer-toast');
  t.textContent = msg;
  t.className = ok ? 'text-sm text-emerald-400' : 'text-sm text-rose-400';
  setTimeout(()=>{ t.textContent=''; t.className='text-sm text-gray-400'; }, 2500);
};

/* ===== API loaders ===== */
async function loadUser(userId){
  const res = await api(`/api/users/${userId}`);
  if(!res.ok) throw new Error('Не удалось загрузить пользователя');
  return res.json();
}

/* ===== Fillers ===== */
function fillProfile(u){
  qs('#f-id').value = u.id ?? '';
  qs('#f-name').value = u.name ?? '';
  qs('#f-kaf').value  = u.kaf ?? '';
  qs('#f-type').value = u.type ?? '';
  qs('#f-status').checked = !!u.status;
  qs('#f-pin').value  = u.pin ?? '';
  qs('#f-email').value = u.email ?? '';
  qs('#f-nickname').value = u.nickname ?? '';
  qs('#f-msgnickname').value = u.msgnickname ?? '';
  qs('#f-msgnickname-normalized').value = u.msgnickname_normalized ?? '';
  qs('#f-tg-id').value = u.tg_id ?? '';
  qs('#f-allow-discovery').checked = Number(u.allow_discovery_outside_harmony ?? 0) === 1;
  qs('#drawer-title').textContent = u.id ? 'Редактировать пользователя' : 'Новый пользователь';
  qs('#drawer-sub').textContent = 'ID: ' + (u.id ?? '—');
}
function clearRoles(){ qsa('.role-checkbox', userDrawer).forEach(cb => (cb.checked = false)); }
function fillRoles(rights){
  const key = ({srv_id, role_id}) => `srv:${srv_id}|role:${role_id}`;
  const set = new Set((rights||[]).map(key));
  qsa('.role-checkbox', userDrawer).forEach(cb => {
    const k = `srv:${cb.dataset.srvId}|role:${cb.dataset.roleId}`;
    cb.checked = set.has(k);
  });
}
function clearLogins(){
  qsa('#logins-tbody tr', userDrawer).forEach(tr => {
    qs('.login-input', tr).value = '';
    qs('.pass-input', tr).value  = '';
  });
}
// logins = [{ srv_id, login, pass }]
function fillLogins(logins) {
  const lmap = new Map((logins || []).map(l => [String(l.srv_id), l.login || '']));
  const pmap = new Map((logins || []).map(l => [String(l.srv_id), l.pass  || '']));

  qsa('#logins-tbody tr', userDrawer).forEach(tr => {
    const k = tr.dataset.srvId;
    qs('.login-input', tr).value = lmap.get(k) || '';
    qs('.pass-input',  tr).value = pmap.get(k) || '';
  });
}

/* ===== Table row helpers (update UI immediately) ===== */
const tbody = qs('#users-tbody');

function typeNameById(id){
  return TYPE_LABELS[String(id)] || '—';
}
function kafNameById(id){
  return KAF_LABELS[String(id)] || '—';
}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);
}

function nickValue(u){
  const raw = String(u.msgnickname_normalized || u.nickname || '').trim();
  if (!raw) return '—';
  return raw.startsWith('@') ? raw : '@' + raw;
}

function userMetaText(u){
  const email = String(u.email || '').trim();
  return `Nick: ${nickValue(u)}${email ? `, Email: ${email}` : ''}, ID: ${u.id ?? '—'}`;
}

function renderStatusBadge(status){
  if (Number(status)) {
    return `
      <span class="users-badge inline-flex items-center gap-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Активен
      </span>`;
  }
  return `
      <span class="users-badge inline-flex items-center gap-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 px-2 py-0.5 text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Заблокирован
      </span>`;
}

function rowHTML(u){
  const initial = (u.name||'').trim().charAt(0) || '?';
  return `
  <tr class="hover:bg-gray-800/50 transition"
      data-user-id="${escapeHtml(u.id)}"
      data-user-name="${escapeHtml(u.name||'')}"
      data-user-kaf="${escapeHtml(u.kaf||'')}"
      data-user-type="${escapeHtml(u.type||0)}"
      data-user-status="${escapeHtml(u.status||0)}"
      data-user-pin="${escapeHtml(u.pin||'')}"
      data-user-nickname="${escapeHtml(u.nickname||'')}"
      data-user-msgnickname="${escapeHtml(u.msgnickname||'')}"
      data-user-msgnickname-normalized="${escapeHtml(u.msgnickname_normalized||'')}"
      data-user-email="${escapeHtml(u.email||'')}"
      data-user-tg-id="${escapeHtml(u.tg_id||'')}"
      data-user-allow-discovery-outside-harmony="${escapeHtml(u.allow_discovery_outside_harmony||0)}">
    <td class="users-td">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-indigo-600/20 flex items-center justify-center text-indigo-300 text-sm font-semibold">${escapeHtml(initial)}</div>
        <div class="min-w-0">
          <div class="user-name-text text-sm font-medium text-gray-100 truncate">${escapeHtml(u.name||'')}</div>
          <div class="user-meta-line text-xs text-gray-500">${escapeHtml(userMetaText(u))}</div>
        </div>
      </div>
    </td>
    <td class="users-td text-sm text-gray-300 user-kaf-cell">${escapeHtml(kafNameById(u.kaf))}</td>
    <td class="users-td text-sm">
      <span class="users-badge inline-flex items-center rounded-md bg-gray-800 border border-gray-700 px-2 py-0.5 text-gray-200 text-xs">${escapeHtml(typeNameById(u.type))}</span>
    </td>
    <td class="users-td">${renderStatusBadge(u.status)}</td>
    <td class="users-td font-mono text-sm text-gray-200 user-pin-cell">${escapeHtml(u.pin||'')}</td>
    <td class="users-td">
      <div class="users-actions">
        <button type="button" class="action-btn open-drawer" data-open-tab="profile" aria-label="Редактировать профиль">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21h4l11-11a2.828 2.828 0 1 0-4-4L4 17v4Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="action-btn open-drawer" data-open-tab="roles" aria-label="Права">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9 4.5v9L12 21 3 16.5v-9L12 3Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="action-btn open-drawer" data-open-tab="logins" aria-label="Логины">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Zm0 10a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="action-btn action-btn-danger" data-action="delete" aria-label="Удалить">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m1 0v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7h10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </td>
  </tr>`;
}

function updateRowUI(u){
  let tr = qs(`#users-tbody tr[data-user-id="${u.id}"]`);
  if (!tr) {
    // добавляем новую строку
    tbody.insertAdjacentHTML('afterbegin', rowHTML(u));
    return;
  }
  // datasets
  tr.dataset.userName   = u.name || '';
  tr.dataset.userKaf    = u.kaf  || '';
  tr.dataset.userType   = String(u.type || 0);
  tr.dataset.userStatus = String(u.status || 0);
  tr.dataset.userPin    = u.pin || '';
  tr.dataset.userNickname = u.nickname || '';
  tr.dataset.userMsgnickname = u.msgnickname || '';
  tr.dataset.userMsgnicknameNormalized = u.msgnickname_normalized || '';
  tr.dataset.userEmail = u.email || '';
  tr.dataset.userTgId = (u.tg_id ?? '').toString();
  tr.dataset.userAllowDiscoveryOutsideHarmony = String(u.allow_discovery_outside_harmony || 0);

  // Имя + ID
  const nameEl = qs('.user-name-text', tr);
  if (nameEl) nameEl.textContent = u.name || '';
  let metaEl = qs('.user-meta-line', tr);
  if (!metaEl && nameEl?.parentElement) {
    metaEl = document.createElement('div');
    metaEl.className = 'user-meta-line text-xs text-gray-500';
    nameEl.after(metaEl);
  }
  if (metaEl) metaEl.textContent = userMetaText(u);
  qs('.user-email-line', tr)?.remove();

  // Подразделение
  const kafTd = qs('.user-kaf-cell', tr);
  if (kafTd) kafTd.textContent = kafNameById(u.kaf);

  // Тип
  const typeTd = tr.children[2];
  if (typeTd) {
    const badge = qs('span', typeTd);
    if (badge) badge.textContent = typeNameById(u.type);
  }

  // Статус
  const statusTd = tr.children[3];
  if (statusTd) statusTd.innerHTML = renderStatusBadge(u.status);

  // PIN
  const pinTd = tr.children[4];
  if (pinTd) pinTd.textContent = u.pin || '';

}

/* ===== Open drawer (delegated) ===== */
tbody?.addEventListener('click', async (e) => {
  const btn = e.target.closest('.open-drawer');
  if (!btn) return;
  const tr = btn.closest('tr');
  const id = tr?.dataset.userId;
  const tab = btn.dataset.openTab || 'profile';
  setDrawerOpen(true);
  setTab(tab);
  try{
    const data = await loadUser(id);
    fillProfile(data.user || {});
    clearRoles();  fillRoles(data.rights || []);
    clearLogins(); fillLogins(data.logins || []);
  }catch(err){
    toast(err.message, false);
  }
});

/* ===== Create new user ===== */
function openCreate(){
  setDrawerOpen(true);
  setTab('profile');
  fillProfile({ id:null, name:'', kaf:'', type:'', status:1, pin:'', email:'', nickname:'', msgnickname:'', msgnickname_normalized:'', tg_id:'', allow_discovery_outside_harmony:0 });
  clearRoles(); clearLogins();
}
qs('#btn-create-user')?.addEventListener('click', openCreate);
qs('#btn-create-user-empty')?.addEventListener('click', openCreate);

/* ===== Close drawer ===== */
qsa('[data-close]', userDrawer).forEach(b => b.addEventListener('click', ()=> setDrawerOpen(false)));
userBackdrop?.addEventListener('click', ()=> setDrawerOpen(false));
document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') setDrawerOpen(false); });

/* ===== Tabs ===== */
qsa('.tab-btn', userDrawer).forEach(b => b.addEventListener('click', ()=> setTab(b.dataset.tab)));

/* ===== Generators ===== */
qs('#btn-gen-pin')?.addEventListener('click', ()=>{
  // 7-значный PIN (цифры)
  let pin = '';
  const arr = new Uint32Array(7);
  crypto.getRandomValues(arr);
  pin = Array.from(arr, n => (n % 10)).join('');
  qs('#f-pin').value = pin;
});

userDrawer.addEventListener('click', (e)=>{
  const btn = e.target.closest('.gen-pass');
  if (!btn) return;
  const tr = btn.closest('tr');
  const p = Array.from(crypto.getRandomValues(new Uint8Array(12)))
                  .map(n=>('0'+(n%36).toString(36)).slice(-1)).join('');
  qs('.pass-input', tr).value = p;
});

/* ===== Save current tab ===== */
qs('#btn-save-current')?.addEventListener('click', async ()=>{
  const active = qs('.tab-btn[data-active="true"]')?.dataset.tab || 'profile';
  const idVal  = qs('#f-id').value || null;

  try{
    if(active === 'profile'){
      const body = {
        id: idVal ? Number(idVal) : null,
        name: qs('#f-name').value.trim(),
        kaf:  qs('#f-kaf').value.trim(),
        type: Number(qs('#f-type').value || 0),
        status: qs('#f-status').checked ? 1 : 0,
        pin:  qs('#f-pin').value.trim(),
        email: qs('#f-email').value.trim(),
        nickname: qs('#f-nickname').value.trim(),
        msgnickname: qs('#f-msgnickname').value.trim(),
        msgnickname_normalized: qs('#f-msgnickname-normalized').value.trim(),
        tg_id: qs('#f-tg-id').value.trim(),
        allow_discovery_outside_harmony: qs('#f-allow-discovery').checked ? 1 : 0
      };
      const res = await api('/api/users' + (idVal ? `/${idVal}` : ''), {
        method: idVal ? 'PUT' : 'POST',
        body: JSON.stringify(body)
      });
      if(!res.ok) throw new Error('Ошибка сохранения профиля');
      const data = await res.json().catch(()=> ({}));

      // если новый пользователь — получим id от бэка и перезагрузим данные
      const newId = idVal ? Number(idVal) : Number(data.id);
      if (!newId) {
        // fallback: просто уведомим
        toast('Профиль сохранён');
        return;
      }

      // подтягиваем свежие данные и обновляем UI
      const fresh = await loadUser(newId);
      const u = fresh.user || { id:newId, ...body };
      // обновляем форму (на случай автозамены / нормализации)
      fillProfile(u);
      // обновляем таблицу
      updateRowUI(u);

      toast('Профиль сохранён');
    }

    if(active === 'roles'){
      const uid = Number(qs('#f-id').value);
      if(!uid) throw new Error('Сначала сохраните профиль');
      const pairs = qsa('.role-checkbox:checked', userDrawer).map(cb => ({
        srv_id: Number(cb.dataset.srvId),
        role_id: Number(cb.dataset.roleId)
      }));
      const res = await api(`/api/users/${uid}/rights`, {
        method:'PUT',
        body: JSON.stringify({ pairs })
      });
      if(!res.ok) throw new Error('Ошибка сохранения ролей');
      toast('Права сохранены');
    }

    if(active === 'logins'){
      const uid = Number(qs('#f-id').value);
      if(!uid) throw new Error('Сначала сохраните профиль');
      const rows = qsa('#logins-tbody tr', userDrawer).map(tr => ({
        srv_id: Number(tr.dataset.srvId),
        login:  qs('.login-input', tr).value.trim(),
        new_password: qs('.pass-input', tr).value
      }));
      const res = await api(`/api/users/${uid}/logins`, {
        method:'PUT',
        body: JSON.stringify({ rows })
      });
      if(!res.ok) throw new Error('Ошибка сохранения логинов');
      qsa('.pass-input', userDrawer).forEach(i => i.value = '');
      toast('Логины сохранены');
    }
  }catch(err){
    toast(err.message, false);
  }
});

/* ===== Delete (delegated) ===== */
tbody?.addEventListener('click', async (e)=>{
  const btn = e.target.closest('button[data-action="delete"]');
  if (!btn) return;
  const tr = btn.closest('tr');
  const id = tr?.dataset.userId;
  if (!id) return;
  if (!confirm('Удалить пользователя #' + id + '?')) return;
  const res = await api(`/api/users/${id}`, { method:'DELETE' });
  if (res.ok) tr.remove();
  else alert('Не удалось удалить пользователя');
});

/* ===== Filters & search ===== */
function applyFilters(){
  const q  = (qs('#user-search')?.value || '').trim().toLowerCase();
  const st = qs('#filter-status')?.value || '';
  const tp = qs('#filter-type')?.value || '';

  qsa('#users-tbody tr').forEach(tr => {
    const name = tr.dataset.userName?.toLowerCase() || '';
    const pin  = tr.dataset.userPin?.toLowerCase()  || '';
    const nick = tr.dataset.userNickname?.toLowerCase() || tr.dataset.userMsgnicknameNormalized?.toLowerCase() || '';
    const email = tr.dataset.userEmail?.toLowerCase() || '';
    const passQ  = !q || name.includes(q) || pin.includes(q) || nick.includes(q) || email.includes(q);
    const passSt = !st || tr.dataset.userStatus === st;
    const passTp = !tp || tr.dataset.userType   === tp;
    tr.classList.toggle('hidden', !(passQ && passSt && passTp));
  });
}
qs('#user-search')?.addEventListener('input',  applyFilters);
qs('#filter-status')?.addEventListener('change', applyFilters);
qs('#filter-type')?.addEventListener('change',  applyFilters);

</script>

<!-- ===== Drawer: Services ↔ Roles panel (unchanged logic, with save refresh) ===== -->
<script>
(function(){
  const openBtn  = document.getElementById('btn-srvs-roles');
  const drawer   = document.getElementById('srvroles-drawer');
  if(!drawer) return;

  const backdrop = drawer.querySelector('[data-backdrop]');
  const panel    = backdrop.nextElementSibling;
  const tbody    = drawer.querySelector('#srvroles-tbody');
  const search   = drawer.querySelector('#srvroles-search');
  const saveBtns = [document.getElementById('srvroles-save'), document.getElementById('srvroles-save-bottom')].filter(Boolean);

  function openDrawer(){
    drawer.classList.remove('hidden');
    requestAnimationFrame(()=>{
      backdrop.style.opacity='1';
      panel.style.transform='translateX(0)';
      initChecks();
    });
  }
  function closeDrawer(){
    backdrop.style.opacity='0';
    panel.style.transform='translateX(100%)';
    setTimeout(()=>drawer.classList.add('hidden'), 200);
  }

  openBtn?.addEventListener('click', openDrawer);
  drawer.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', closeDrawer));
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && !drawer.classList.contains('hidden')) closeDrawer(); });

  function initChecks(){
    tbody.querySelectorAll('tr').forEach(tr=>{
      const allowed = (tr.dataset.allowedRoles || '').split(',').filter(Boolean);
      const set = new Set(allowed);
      tr.querySelectorAll('.srv-role-checkbox').forEach(cb=>{ cb.checked = set.has(cb.dataset.roleId); });
    });
  }

  tbody.addEventListener('click', (e)=>{
    const btn = e.target.closest('.sel-all, .sel-none');
    if(!btn) return;
    const tr = btn.closest('tr');
    tr.querySelectorAll('.srv-role-checkbox').forEach(cb=>{ cb.checked = btn.classList.contains('sel-all'); });
  });

  search?.addEventListener('input', ()=>{
    const q = search.value.trim().toLowerCase();
    tbody.querySelectorAll('tr').forEach(tr=>{
      const name = (tr.dataset.srvName || '').toLowerCase();
      tr.classList.toggle('hidden', q && !name.includes(q));
    });
  });

  async function save(){
    const pairs = [];
    tbody.querySelectorAll('tr').forEach(tr=>{
      const srvId = Number(tr.dataset.srvId);
      tr.querySelectorAll('.srv-role-checkbox:checked').forEach(cb=>{
        pairs.push({ srv_id: srvId, role_id: Number(cb.dataset.roleId) });
      });
    });
    try{
      const res = await fetch('/api/srvs-roles', {
        method: 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ pairs })
      });
      if(!res.ok) throw new Error('Ошибка сохранения');
      closeDrawer();
      // опционально: перезагрузить справочник в памяти/на странице (если нужно)
    }catch(err){
      alert(err.message);
    }
  }
  saveBtns.forEach(b => b?.addEventListener('click', save));
})();
</script>

<script>
  /* ===== Errrules sidebar ===== */
const errSearch = qs('#errrules-search');
const errList   = qs('#errrules-list');

function applyErrrulesFilter(){
  if(!errList) return;
  const q = (errSearch?.value || '').trim().toLowerCase();
  qsa('.errrules-item', errList).forEach(btn => {
    const name = (btn.dataset.userName || '').toLowerCase();
    const id   = String(btn.dataset.userId || '');
    const miss = (btn.dataset.missing || '').toLowerCase();
    btn.classList.toggle('hidden', q && !(name.includes(q) || id.includes(q) || miss.includes(q)));
  });
}
errSearch?.addEventListener('input', applyErrrulesFilter);

errList?.addEventListener('click', (e) => {
  const btn = e.target.closest('.errrules-item');
  if(!btn) return;
  const id = btn.dataset.userId;
  const tr = qs(`#users-tbody tr[data-user-id="${id}"]`);
  if(!tr) return;

  tr.scrollIntoView({ behavior: 'smooth', block: 'center' });
  tr.classList.add('ring-2','ring-indigo-500/60');
  setTimeout(()=> tr.classList.remove('ring-2','ring-indigo-500/60'), 1800);
});

</script>
