{{!-- User-management workspace --}}
<link rel="stylesheet" href="/css/users.css">
<script>document.body.classList.add('users-route');</script>

<main class="users-workspace">
  <section aria-labelledby="users-title">
    <header class="users-workspace-header">
      <div>
        <h1 class="users-title" id="users-title">Пользователи</h1>
        <p class="users-subtitle">Рабочее пространство администратора</p>
        <p class="users-count" id="users-count" aria-live="polite">Найдено: <span id="users-visible">{{users.length}}</span> из <span id="users-total">{{users.length}}</span></p>
      </div>
      <div class="users-toolbar-actions">
        <button class="users-menu-button" id="btn-srvs-roles" type="button" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M4 7h16M4 12h10M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Настройки ролей сервисов
        </button>
        <button class="users-primary-button" id="btn-create-user" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Новый пользователь
        </button>
      </div>
    </header>

    <div class="users-toolbar">
      <label class="users-search-wrap" for="user-search">
        <span class="sr-only">Поиск пользователей</span>
        <svg class="users-search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input class="users-search" id="user-search" type="search" autocomplete="off" placeholder="Имя, ник, PIN, ID, роль…">
        <button class="users-search-clear" id="user-search-clear" type="button" aria-label="Очистить поиск" hidden>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </label>
      <div class="users-toolbar-actions">
        <label class="sr-only" for="mobile-sort">Сортировка</label>
        <select class="users-select" id="mobile-sort">
          <option value="id:desc">Сначала новые</option>
          <option value="name:asc">Имя: А—Я</option>
          <option value="name:desc">Имя: Я—А</option>
          <option value="kaf:asc">Подразделение</option>
          <option value="type:asc">Роль</option>
          <option value="status:desc">Статус</option>
          <option value="pin:asc">PIN</option>
          <option value="birth_date:asc">День рождения</option>
          <option value="nick:asc">Ник</option>
        </select>
      </div>
    </div>

    <div class="users-filters" aria-label="Фильтры пользователей">
      <label class="sr-only" for="filter-status">Статус</label>
      <select class="users-filter" id="filter-status"><option value="">Статус: все</option><option value="1">Статус: активные</option><option value="0">Статус: заблокированные</option></select>
      <label class="sr-only" for="filter-type">Роль</label>
      <select class="users-filter" id="filter-type"><option value="">Роль: все</option>{{#each types}}<option value="{{this.id}}">Роль: {{this.name}}</option>{{/each}}</select>
      <label class="sr-only" for="filter-kaf">Подразделение</label>
      <select class="users-filter" id="filter-kaf"><option value="">Подразделение: все</option>{{#each kafs}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select>
      <button class="users-reset" id="users-reset" type="button" hidden>Сбросить фильтры</button>
    </div>

    {{#if errrules.length}}
      <button class="users-alert" id="btn-open-issues" type="button" aria-haspopup="dialog">
        <span class="users-alert-main"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="M12 3 2.8 20h18.4L12 3Zm0 6v4m0 4h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>Проблемы доступа: {{errrules.length}}</strong><br><span>Для части пользователей не назначены роли сервисов</span></span></span>
        <svg class="users-alert-chevron" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {{else}}
      <div class="users-alert users-alert--ok" role="status">Все пользователи имеют назначенные роли сервисов.</div>
    {{/if}}

    <section class="users-list" aria-labelledby="users-list-title">
      <h2 class="sr-only" id="users-list-title">Список пользователей</h2>
      <div class="users-empty" id="users-empty" {{#if users.length}}hidden{{/if}}>Пользователей пока нет. Создайте первую запись.</div>
      <table class="users-table" id="users-table" {{#unless users.length}}hidden{{/unless}}>
        <colgroup><col><col><col><col><col><col></colgroup>
        <thead><tr>
          <th scope="col" aria-sort="none"><button class="users-sort-button" type="button" data-sort="name">Пользователь <svg class="users-sort-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m8 9 4-4 4 4M16 15l-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></th>
          <th scope="col" aria-sort="none"><button class="users-sort-button" type="button" data-sort="kaf">Подразделение <svg class="users-sort-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m8 9 4-4 4 4M16 15l-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></th>
          <th scope="col" aria-sort="none"><button class="users-sort-button" type="button" data-sort="type">Роль <svg class="users-sort-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m8 9 4-4 4 4M16 15l-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></th>
          <th scope="col" aria-sort="none"><button class="users-sort-button" type="button" data-sort="status">Статус <svg class="users-sort-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m8 9 4-4 4 4M16 15l-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></th>
          <th scope="col" aria-sort="none"><button class="users-sort-button" type="button" data-sort="pin">PIN <svg class="users-sort-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none"><path d="m8 9 4-4 4 4M16 15l-4 4-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button></th>
          <th scope="col">Действия</th>
        </tr></thead>
        <tbody id="users-tbody">
          {{#each users}}
            <tr class="user-row" data-user-id="{{this.id}}" data-user-name="{{this.name}}" data-user-kaf="{{this.kaf}}" data-user-type="{{this.type}}" data-user-status="{{this.status}}" data-user-pin="{{this.pin}}" data-user-nickname="{{this.nickname}}" data-user-msgnickname="{{this.msgnickname}}" data-user-msgnickname-normalized="{{this.msgnickname_normalized}}" data-user-birth-date="{{this.birth_date}}" data-user-tg-id="{{this.tg_id}}" data-user-avatar-url-custom="{{this.avatar_url_custom}}" data-user-display-name-custom="{{this.display_name_custom}}" data-user-allow-discovery-outside-harmony="{{this.allow_discovery_outside_harmony}}">
              <td><div class="user-identity"><span class="user-avatar" aria-hidden="true">{{#if this.name}}{{substr this.name 0 1}}{{else}}?{{/if}}</span><span class="user-identity-copy"><span class="user-name">{{this.name}}</span><span class="user-secondary">{{#if this.msgnickname_normalized}}@{{this.msgnickname_normalized}}{{else}}{{#if this.nickname}}@{{this.nickname}}{{else}}Ник не указан{{/if}}{{/if}}{{#if this.birth_date}} · {{formatBirthDate this.birth_date}}{{/if}}</span></span></div></td>
              <td><span class="user-cell-text">{{#with (findById ../kafs this.kaf)}}{{this.name}}{{else}}—{{/with}}</span></td>
              <td><span class="user-role">{{#with (findById ../types this.type)}}{{this.name}}{{else}}—{{/with}}</span></td>
              <td>{{#if this.status}}<span class="user-status user-status--active">Активен</span>{{else}}<span class="user-status user-status--blocked">Заблокирован</span>{{/if}}</td>
              <td><button class="user-pin user-pin-reveal" type="button" aria-label="Показать PIN пользователя {{this.name}}" aria-pressed="false" title="Показать PIN">••••••</button></td>
              <td><div class="user-actions"><button class="users-icon-button action-menu-toggle" type="button" aria-label="Действия пользователя {{this.name}}" aria-haspopup="menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg></button><div class="users-action-menu" role="menu" hidden><button class="users-action-item" type="button" role="menuitem" data-open-tab="profile">Профиль</button><button class="users-action-item" type="button" role="menuitem" data-open-tab="roles">Доступы</button><button class="users-action-item" type="button" role="menuitem" data-open-tab="logins">Учётные записи</button><button class="users-action-item users-action-item--danger" type="button" role="menuitem" data-action="delete">Удалить</button></div></div></td>
            </tr>
          {{/each}}
          <tr class="users-no-results" id="users-no-results" hidden><td colspan="6">По вашему запросу ничего не найдено.</td></tr>
        </tbody>
      </table>
      <p class="users-live-region" id="users-live" aria-live="polite"></p>
    </section>
  </section>
</main>

<aside class="users-drawer users-drawer--narrow" id="issues-drawer" aria-hidden="true" aria-labelledby="issues-title" role="dialog" aria-modal="true"><div class="users-drawer-backdrop" data-close-drawer></div><div class="users-drawer-panel"><header class="users-drawer-header"><div><h2 class="users-drawer-title" id="issues-title">Проблемы доступа</h2><p class="users-drawer-subtitle">Выберите пользователя, чтобы назначить недостающие роли.</p></div><button class="users-drawer-close" type="button" data-close-drawer aria-label="Закрыть"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></header><div class="users-drawer-body"><label class="users-search-wrap" for="issues-search"><span class="sr-only">Поиск проблемных пользователей</span><svg class="users-search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><input class="users-search" id="issues-search" type="search" placeholder="Имя, ID или сервис" autocomplete="off"></label><div class="users-issues-list" id="issues-list" style="margin-top:1rem">{{#each errrules}}<button class="users-issue-item" type="button" data-user-id="{{this.id}}" data-search="{{this.name}} {{this.id}} {{this.missing_srv_names}}"><span class="users-issue-name">{{this.name}}</span><span class="users-issue-meta">ID: {{this.id}}</span><span class="users-issue-missing">{{this.missing_srv_names}}</span></button>{{/each}}</div></div></div></aside>

<aside class="users-drawer" id="service-roles-drawer" aria-hidden="true" aria-labelledby="service-roles-title" role="dialog" aria-modal="true"><div class="users-drawer-backdrop" data-close-drawer></div><div class="users-drawer-panel"><header class="users-drawer-header"><div><h2 class="users-drawer-title" id="service-roles-title">Роли в сервисах</h2><p class="users-drawer-subtitle">Настройте, какие роли доступны при выдаче доступа.</p></div><button class="users-drawer-close" type="button" data-close-drawer aria-label="Закрыть"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></header><div class="users-drawer-body"><label class="users-search-wrap" for="service-roles-search"><span class="sr-only">Поиск сервиса</span><svg class="users-search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><input class="users-search" id="service-roles-search" type="search" placeholder="Поиск сервиса" autocomplete="off"></label><div class="users-service-table" style="margin-top:1rem"><table><thead><tr><th>Сервис</th><th>Доступные роли</th><th></th></tr></thead><tbody id="service-roles-tbody">{{#each services}}{{#if (eq this.types 0)}}<tr data-srv-id="{{this.id}}" data-srv-name="{{this.name}}" data-allowed-roles="{{#each this.roles}}{{this.id}}{{#unless @last}},{{/unless}}{{/each}}"><td>{{this.name}}</td><td><div class="users-service-options">{{#each ../allRoles}}<label class="users-check-chip"><input class="service-role-checkbox" type="checkbox" data-role-id="{{this.id}}"><span>{{this.name}}</span></label>{{/each}}</div></td><td><div class="users-service-actions"><button type="button" data-service-action="all">Все</button><button type="button" data-service-action="none">Снять</button></div></td></tr>{{/if}}{{/each}}</tbody></table></div></div><footer class="users-drawer-footer"><span class="users-drawer-message" id="service-roles-message" aria-live="polite"></span><div class="users-drawer-actions"><button class="users-cancel-button" type="button" data-close-drawer>Отмена</button><button class="users-save-button" id="btn-save-service-roles" type="button">Сохранить</button></div></footer></div></aside>

<aside class="users-drawer" id="user-drawer" aria-hidden="true" aria-labelledby="user-drawer-title" role="dialog" aria-modal="true"><div class="users-drawer-backdrop" data-close-drawer></div><div class="users-drawer-panel"><header class="users-drawer-header"><div><h2 class="users-drawer-title" id="user-drawer-title">Новый пользователь</h2><p class="users-drawer-subtitle" id="user-drawer-subtitle">ID: —</p></div><button class="users-drawer-close" type="button" data-close-drawer aria-label="Закрыть"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></header><nav class="users-tabs" aria-label="Разделы пользователя" role="tablist"><button class="users-tab" type="button" role="tab" id="tab-profile-button" aria-controls="tab-profile" aria-selected="true" data-tab="profile">Профиль</button><button class="users-tab" type="button" role="tab" id="tab-roles-button" aria-controls="tab-roles" aria-selected="false" data-tab="roles">Доступы</button><button class="users-tab" type="button" role="tab" id="tab-logins-button" aria-controls="tab-logins" aria-selected="false" data-tab="logins">Учётные записи</button></nav><div class="users-drawer-body">
  <section class="users-tab-panel" id="tab-profile" role="tabpanel" aria-labelledby="tab-profile-button">
    <form id="form-profile" novalidate>
      <input id="f-id" name="id" type="hidden">

      <div class="users-form-section">
        <h4>Основное</h4>
        <div class="users-form-grid">
          <div class="users-field users-field--wide">
            <label for="f-name">Имя</label>
            <input class="users-input" id="f-name" name="name" type="text" required autocomplete="name">
          </div>
          <div class="users-field">
            <label for="f-kaf">Подразделение</label>
            <select class="users-select" id="f-kaf" name="kaf"><option value="">Не выбрано</option>{{#each kafs}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select>
          </div>
          <div class="users-field">
            <label for="f-type">Роль</label>
            <select class="users-select" id="f-type" name="type">{{#each types}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}</select>
          </div>
          <div class="users-field">
            <span class="users-field-label">Статус</span>
            <label class="users-switch"><input id="f-status" name="status" type="checkbox"><span class="users-switch-track" aria-hidden="true"></span><span>Активен</span></label>
          </div>
          <div class="users-field">
            <label for="f-pin">PIN</label>
            <input class="users-input" id="f-pin" name="pin" type="text" maxlength="10" autocomplete="off">
            <p class="users-field-hint">Уникальный код до 10 символов.</p>
          </div>
          <div class="users-field">
            <label for="f-birth-date">День рождения</label>
            <input class="users-input" id="f-birth-date" name="birth_date" type="date" autocomplete="bday">
          </div>
          <div class="users-field users-field--wide">
            <label for="f-display-name-custom">Отображаемое имя</label>
            <input class="users-input" id="f-display-name-custom" name="display_name_custom" type="text" placeholder="Если нужно переопределить имя">
          </div>
        </div>
      </div>

      <details class="users-advanced">
        <summary>Дополнительно</summary>
        <div class="users-advanced-content">
          <div class="users-form-grid">
            <div class="users-field users-field--wide">
              <label for="f-messenger-username">Ник в Балалайке</label>
              <input class="users-input" id="f-messenger-username" name="messenger_username" type="text" autocomplete="off" placeholder="например, ivan_ivanov">
              <p class="users-field-hint">Можно ввести с @ — система приведёт ник к единому формату.</p>
            </div>
            <div class="users-field">
              <label for="f-tg-id">Telegram ID</label>
              <input class="users-input" id="f-tg-id" name="tg_id" type="number" inputmode="numeric">
            </div>
            <div class="users-field">
              <span class="users-field-label">Видимость вне Гармонии</span>
              <label class="users-switch"><input id="f-allow-discovery" name="allow_discovery_outside_harmony" type="checkbox"><span class="users-switch-track" aria-hidden="true"></span><span>Разрешена</span></label>
            </div>
            <div class="users-field users-field--wide">
              <label for="f-avatar-url-custom">URL аватара</label>
              <input class="users-input" id="f-avatar-url-custom" name="avatar_url_custom" type="url" placeholder="https://…">
            </div>
          </div>
        </div>
      </details>
    </form>
  </section>
  <section class="users-tab-panel" id="tab-roles" role="tabpanel" aria-labelledby="tab-roles-button" hidden>{{#if services.length}}{{#each services}}{{#if (eq this.types 0)}}<fieldset class="users-role-service"><legend>{{this.name}}</legend><div class="users-role-options">{{#each this.roles}}<label class="users-check-chip"><input class="role-checkbox" type="checkbox" data-srv-id="{{../id}}" data-role-id="{{this.id}}"><span>{{this.name}}</span></label>{{/each}}</div></fieldset>{{/if}}{{/each}}{{else}}<p class="users-drawer-message">Справочник сервисов пуст.</p>{{/if}}</section>
  <section class="users-tab-panel" id="tab-logins" role="tabpanel" aria-labelledby="tab-logins-button" hidden>{{#if services.length}}<div class="users-logins" id="logins-tbody">{{#each services}}{{#if (eq this.types 1)}}<div class="users-login-row" data-srv-id="{{this.id}}"><div class="users-login-service">{{this.name}}</div><label class="users-field"><span class="users-field-label">Логин</span><input class="users-input login-input" type="text" autocomplete="off" placeholder="Логин"></label><label class="users-field"><span class="users-field-label">PIN/код доступа</span><span class="users-code-wrap"><input class="users-input pass-input" type="password" autocomplete="off" placeholder="Не задан"><button class="users-reveal-button reveal-pass" type="button" aria-label="Показать PIN/код доступа" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="2"/></svg></button></span></label></div>{{/if}}{{/each}}</div><p class="users-code-note">Коды скрыты как сообщения в Telegram. Нажмите на значок глаза рядом с конкретным значением, чтобы временно показать его.</p>{{else}}<p class="users-drawer-message">Нет сервисов с учётными записями.</p>{{/if}}</section>
</div><footer class="users-drawer-footer"><span class="users-drawer-message" id="user-drawer-message" aria-live="polite"></span><div class="users-drawer-actions"><button class="users-cancel-button" type="button" data-close-drawer>Отмена</button><button class="users-save-button" id="btn-save-current" type="button">Сохранить</button></div></footer></div></aside>

<script type="module" src="/js/users.js"></script>
