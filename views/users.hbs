{{!-- users.hbs --}}
<main class="pt-8 px-4 max-w-7xl mx-auto space-y-6">
{{!-- Кнопка открытия панели связки "сервисы ↔ доступные роли" --}}
<button type="button" id="btn-srvs-roles"
        class="inline-flex items-center gap-2 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-100 px-4 py-2.5 border border-gray-700">
  <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
    <path d="M4 7h16v2H4V7Zm0 4h10v2H4v-2Zm0 4h16v2H4v-2Z"/>
  </svg>
  Настроить доступные роли в сервисах
</button>

{{!-- Slide-over: связка сервисов и доступных ролей --}}
<aside id="srvroles-drawer" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="srvroles-title">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity" data-backdrop></div>

  <div class="absolute right-0 top-0 h-full w-full max-w-4xl translate-x-full transition-transform">
    <div class="flex h-full flex-col bg-gray-900 border-l border-gray-800">
      {{!-- Header --}}
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-800">
        <div>
          <h3 id="srvroles-title" class="text-lg font-semibold text-white">Настройка сервисов</h3>
          <p class="text-xs text-gray-400">Определите, какие роли можно назначать в каждом сервисе.</p>
        </div>
        <button type="button" data-close
                class="rounded-lg p-2 text-gray-400 hover:text-white focus-visible:outline-none focus-visible:ring focus-visible:ring-white/20">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>

      {{!-- Toolbar --}}
      <div class="px-5 pt-4 flex items-center justify-between gap-3">
        <label class="relative w-full sm:w-80">
          <input id="srvroles-search" type="search" placeholder="Поиск сервиса"
                 class="w-full rounded-xl bg-gray-800 text-gray-100 placeholder:text-gray-500 border border-gray-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 px-4 py-2.5 outline-none">
          <span class="pointer-events-none absolute right-3 top-2.5 text-gray-500">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none"><path d="M21 21l-4.3-4.3M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </span>
        </label>

        <button type="button" id="srvroles-save"
                class="rounded-xl px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white shadow">
          Сохранить
        </button>
      </div>

      {{!-- Content --}}
      <div class="p-5 overflow-y-auto">
        <div class="rounded-xl border border-gray-800 overflow-hidden">
          <table class="min-w-full divide-y divide-gray-800">
            <thead class="bg-gray-900/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Сервис</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Доступные роли</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Действия</th>
            </tr>
            </thead>
            <tbody id="srvroles-tbody" class="divide-y divide-gray-800 bg-gray-900/30">
            {{!-- services: [{id,name,roles:[{id,name}]}] ; allRoles: [{id,name}] --}}
            {{#each services}}
            {{#if (eq this.types 0)}}
              <tr data-srv-id="{{this.id}}"
                  data-srv-name="{{this.name}}"
                  data-allowed-roles="{{#each this.roles}}{{this.id}}{{#unless @last}},{{/unless}}{{/each}}">
                <td class="px-4 py-3 text-sm text-gray-200 align-top w-56 sm:w-64">{{this.name}}</td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-2">
                    {{#each ../allRoles}}
                      <label class="inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-800 px-2.5 py-1.5 text-gray-200 text-xs hover:border-indigo-500/50">
                        <input type="checkbox" class="srv-role-checkbox accent-indigo-600" data-role-id="{{this.id}}">
                        <span>{{this.name}}</span>
                      </label>
                    {{/each}}
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs bg-gray-800 border border-gray-700 text-gray-300 hover:border-indigo-500/50 sel-all">Все</button>
                    <button type="button" class="rounded-lg px-2.5 py-1.5 text-xs bg-gray-800 border border-gray-700 text-gray-300 hover:border-indigo-500/50 sel-none">Снять</button>
                  </div>
                </td>
              </tr>
            {{/if}}
            {{/each}}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-gray-500">Это <em>справочник</em> ролей по сервисам. Он определяет варианты, которые будут доступны при назначении прав пользователям.</p>
      </div>

      {{!-- Footer --}}
      <div class="mt-auto border-t border-gray-800 px-5 py-4 flex items-center justify-end gap-2">
        <button type="button" data-close class="rounded-xl px-4 py-2.5 text-gray-300 hover:text-white">Закрыть</button>
        <button type="button" id="srvroles-save-bottom" class="rounded-xl px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white">Сохранить</button>
      </div>
    </div>
  </div>
</aside>

  {{!-- Page header --}}
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-white">Пользователи</h1>
      <p class="text-sm text-gray-400">Управление пользователями</p>
    </div>

    <div class="flex items-center gap-3 w-full sm:w-auto">
      <label class="relative flex-1 sm:w-72">
        <input id="user-search" type="search" placeholder="Поиск по имени или PIN"
               class="w-full rounded-xl bg-gray-800 text-gray-100 placeholder:text-gray-500 border border-gray-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 px-4 py-2.5 outline-none">
        <span class="pointer-events-none absolute right-3 top-2.5 text-gray-500">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5"><path d="M21 21l-4.3-4.3M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
      </label>

      <button type="button" id="btn-create-user"
              class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2.5 shadow focus-visible:outline-none focus-visible:ring focus-visible:ring-indigo-400">
        <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Новый пользователь
      </button>
    </div>
  </header>

  {{!-- Filters --}}
 
<section class="flex flex-wrap items-center gap-4">
  {{!-- Статус --}}
  <div class="flex items-center gap-2">
    <label for="filter-status" class="text-sm text-gray-400">Статус:</label>
    <div class="relative w-44 sm:w-56 md:w-64">
      <select id="filter-status"
              class="block w-full appearance-none pr-8
                     rounded-lg bg-gray-800 text-gray-100
                     border border-gray-700 px-3 py-1.5
                     focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30">
        <option value="">Все</option>
        <option value="1">Активные</option>
        <option value="0">Заблокированные</option>
      </select>
      <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
           viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" clip-rule="evenodd"/>
      </svg>
    </div>
  </div>

  {{!-- Роль --}}
  <div class="flex items-center gap-2">
    <label for="filter-type" class="text-sm text-gray-400">Роль:</label>
    <div class="relative w-44 sm:w-56 md:w-64">
      <select id="filter-type"
              class="block w-full appearance-none pr-8
                     rounded-lg bg-gray-800 text-gray-100
                     border border-gray-700 px-3 py-1.5
                     focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30">
        <option value="">Все</option>
        {{#each types}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
           viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" clip-rule="evenodd"/>
      </svg>
    </div>
  </div>
</section>


  {{!-- Users table --}}
  <section aria-labelledby="users-table-heading">
    <h2 id="users-table-heading" class="sr-only">Список пользователей</h2>

    {{#if users.length}}
      <div class="overflow-x-auto rounded-2xl border border-gray-800">
        <table class="min-w-full divide-y divide-gray-800">
          <thead class="bg-gray-900/50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Имя</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Подразделение</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Роль</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Статус</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">PIN</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Действия</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-800 bg-gray-900/30" id="users-tbody">
          {{#each users}}
            <tr class="hover:bg-gray-800/50 transition"
                data-user-id="{{this.id}}"
                data-user-name="{{this.name}}"
                data-user-kaf="{{this.kaf}}"
                data-user-type="{{this.type}}"
                data-user-status="{{this.status}}"
                data-user-pin="{{this.pin}}">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-indigo-600/20 flex items-center justify-center text-indigo-300 text-sm font-semibold">
                    {{#if this.name}}{{substr this.name 0 1}}{{else}}?{{/if}}
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-medium text-gray-100 truncate">{{this.name}}</div>
                    <div class="text-xs text-gray-500">ID: {{this.id}}</div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-300">{{this.kaf}}</td>
              <td class="px-4 py-3 text-sm">
                {{#with (findById ../types this.type) as |t|}}
                  <span class="inline-flex items-center rounded-md bg-gray-800 border border-gray-700 px-2 py-0.5 text-gray-200 text-xs">{{#if t}}{{t.name}}{{else}}—{{/if}}</span>
                {{/with}}
              </td>
              <td class="px-4 py-3">
                {{#if this.status}}
                  <span class="inline-flex items-center gap-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 text-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Активен
                  </span>
                {{else}}
                  <span class="inline-flex items-center gap-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 px-2 py-0.5 text-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Заблокирован
                  </span>
                {{/if}}
              </td>
              <td class="px-4 py-3 font-mono text-sm text-gray-200">{{this.pin}}</td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" class="btn-row open-drawer"
                          data-open-tab="profile"
                          aria-label="Редактировать профиль">
                    <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M4 21h4l11-11a2.828 2.828 0 1 0-4-4L4 17v4Z" fill="currentColor"/></svg>
                  </button>
                  <button type="button" class="btn-row open-drawer"
                          data-open-tab="roles"
                          aria-label="Права">
                    <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M12 3l9 4.5v9L12 21 3 16.5v-9L12 3Z" fill="currentColor"/></svg>
                  </button>
                  <button type="button" class="btn-row open-drawer"
                          data-open-tab="logins"
                          aria-label="Логины">
                    <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Zm0 10a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Z" fill="currentColor"/></svg>
                  </button>
                  <button type="button" class="btn-row text-rose-400 hover:text-rose-300" data-action="delete" aria-label="Удалить">
                    <svg viewBox="0 0 24 24" class="w-5 h-5"><path d="M5 7h14M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m1 0v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7h10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="rounded-2xl border border-dashed border-gray-700 p-10 text-center">
        <p class="text-gray-400">Пользователей пока нет.</p>
        <button type="button" id="btn-create-user-empty"
                class="mt-4 inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2.5 shadow focus-visible:outline-none focus-visible:ring focus-visible:ring-indigo-400">
          Добавить первого пользователя
        </button>
      </div>
    {{/if}}
  </section>
</main>

{{!-- Slide-over drawer --}}
<aside id="user-drawer" class="fixed inset-0 z-50 hidden" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity" data-backdrop></div>

  <div class="absolute right-0 top-0 h-full w-full max-w-xl translate-x-full transition-transform">
    <div class="flex h-full flex-col bg-gray-900 border-l border-gray-800">
      {{!-- Header --}}
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-800">
        <div>
          <h3 id="drawer-title" class="text-lg font-semibold text-white">Новый пользователь</h3>
          <p id="drawer-sub" class="text-xs text-gray-400">ID: —</p>
        </div>
        <button type="button" class="rounded-lg p-2 text-gray-400 hover:text-white focus-visible:outline-none focus-visible:ring focus-visible:ring-white/20" data-close>
          <svg viewBox="0 0 24 24" class="w-5 h-5"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>

      {{!-- Tabs --}}
      <div class="px-5 pt-3">
        <nav class="grid grid-cols-3 gap-2 bg-gray-800 rounded-lg p-1" aria-label="Tabs">
          <button class="tab-btn active rounded-md px-3 py-2 text-sm text-white data-[active=true]:bg-indigo-600"
                  data-tab="profile">Профиль</button>
          <button class="tab-btn rounded-md px-3 py-2 text-sm text-gray-300 hover:text-white data-[active=true]:bg-indigo-600"
                  data-tab="roles">Роли</button>
          <button class="tab-btn rounded-md px-3 py-2 text-sm text-gray-300 hover:text-white data-[active=true]:bg-indigo-600"
                  data-tab="logins">Логины</button>
        </nav>
      </div>

      {{!-- Content --}}
      <div class="flex-1 overflow-y-auto p-5 space-y-6">

        {{!-- PROFILE TAB --}}
        <section id="tab-profile" class="tab-panel space-y-4">
          <form id="form-profile" class="space-y-4">
            <input type="hidden" name="id" id="f-id" value="">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="flex flex-col gap-1">
                <span class="text-sm text-gray-300">Имя</span>
                <input name="name" id="f-name" type="text" required
                       class="rounded-xl bg-gray-800 text-gray-100 border border-gray-700 px-3 py-2.5 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 outline-none">
              </label>

              <label class="flex flex-col gap-1">
                <span class="text-sm text-gray-300">Подразделение</span>
                <input name="kaf" id="f-kaf" type="text"
                       class="rounded-xl bg-gray-800 text-gray-100 border border-gray-700 px-3 py-2.5 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 outline-none">
              </label>

              <label class="flex flex-col gap-1">
                <span class="text-sm text-gray-300">Роль</span>
                <select name="type" id="f-type"
                        class="block w-full appearance-none pr-8
                     rounded-lg bg-gray-800 text-gray-100
                     border border-gray-700 px-3 py-1.5
                     focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30">
                  {{#each types}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
              </label>

              <div class="flex flex-col gap-1">
                <span class="text-sm text-gray-300">Статус</span>
                <label class="inline-flex items-center gap-3">
                  <input type="checkbox" id="f-status" name="status" class="peer sr-only">
                  <span class="w-11 h-6 rounded-full bg-gray-700 relative transition
                               after:content-[''] after:absolute after:w-5 after:h-5 after:bg-white after:rounded-full after:top-0.5 after:left-0.5 after:transition
                               peer-checked:bg-emerald-600 peer-checked:after:translate-x-5"></span>
                  <span class="text-sm text-gray-300">Активен</span>
                </label>
              </div>

              <label class="flex flex-col gap-1 sm:col-span-2">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-300">PIN</span>
                  <!-- <button type="button" id="btn-gen-pin" class="text-xs text-indigo-400 hover:text-indigo-300">Сгенерировать</button>-->
                  
                </div>
                <input name="pin" id="f-pin" type="text" maxlength="10"
                       class="font-mono rounded-xl bg-gray-800 text-gray-100 border border-gray-700 px-3 py-2.5 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 outline-none">
                <p id="pin-hint" class="text-xs text-gray-500">Уникальный код до 10 символов.</p>
              </label>
            </div>
          </form>
        </section>

        {{!-- ROLES TAB --}}
        <section id="tab-roles" class="tab-panel hidden">
          {{#if services.length}}
            <div class="space-y-5">
              {{#each services}}
              {{#if (eq this.types 0)}}
                <fieldset class="rounded-xl border border-gray-800 p-4">
                  <legend class="px-2 text-sm text-gray-400">{{this.name}}</legend>
                  <div class="flex flex-wrap gap-2" data-srv-id="{{this.id}}">
                    {{#each this.roles}}
                      <label class="inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-800 px-3 py-1.5 text-gray-200 text-sm hover:border-indigo-500/50">
                        <input type="checkbox"
                               class="role-checkbox accent-indigo-600"
                               data-srv-id="{{../id}}"
                               data-role-id="{{this.id}}">
                        <span>{{this.name}}</span>
                      </label>
                    {{/each}}
                  </div>
                </fieldset>
              {{/if}}
              {{/each}}
            </div>
          {{else}}
            <p class="text-sm text-gray-400">Справочник сервисов и ролей пуст.</p>
          {{/if}}
        </section>

        {{!-- LOGINS TAB --}}
        <section id="tab-logins" class="tab-panel hidden space-y-3">
          {{#if services.length}}
            <div class="rounded-xl border border-gray-800 overflow-hidden">
              <table class="min-w-full divide-y divide-gray-800">
                <thead class="bg-gray-900/50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Сервис</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Логин</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Новый пароль</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase">Действия</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-800 bg-gray-900/30" id="logins-tbody">
              {{!-- показываем только сервисы с type = 1 --}}
                {{#each services}}
                {{#if (eq this.types 1)}}
                    <tr data-srv-id="{{this.id}}">
                    <td class="px-4 py-3 text-sm text-gray-200">{{this.name}}</td>
                    <td class="px-4 py-3">
                        <input type="text"
                            class="login-input w-full rounded-lg bg-gray-800 text-gray-100 border border-gray-700 px-3 py-2
                                    focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
                            placeholder="логин">
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                        <input type="text"
                                class="pass-input w-full rounded-lg bg-gray-800 text-gray-100 border border-gray-700 px-3 py-2
                                        focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30"
                                placeholder="Новый пароль">

                       <!-- <button type="button"
                                class="rounded-lg px-3 py-2 text-xs bg-gray-800 border border-gray-700 text-gray-300 hover:border-indigo-500/50 gen-pass">
                            Сгенерировать
                        </button> -->
                        </div>
                    </td>
                    <td class="px-4 py-3">
                        <button type="button"
                                class="rounded-lg px-3 py-2 text-xs bg-indigo-600 hover:bg-indigo-500 text-white save-login">
                        Сохранить
                        </button>
                    </td>
                    </tr>
                {{/if}}
                {{/each}}

                </tbody>
              </table>
            </div>
            <p class="text-xs text-gray-500">Пароли хранятся в виде хэш-суммы. Показать существующий пароль невозможно.</p>
          {{else}}
            <p class="text-sm text-gray-400">Нет сервисов.</p>
          {{/if}}
        </section>
      </div>

      {{!-- Footer --}}
      <div class="flex items-center justify-between gap-3 border-t border-gray-800 px-5 py-4">
        <div id="drawer-toast" class="text-sm text-gray-400"></div>
        <div class="flex items-center gap-2">
          <button type="button" class="rounded-xl px-4 py-2.5 text-gray-300 hover:text-white" data-close>Отмена</button>
          <button type="button" id="btn-save-current" class="rounded-xl px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white">Сохранить</button>
        </div>
      </div>
    </div>
  </div>
</aside>

{{!-- Tiny helpers CSS for buttons (keeps markup cleaner) --}}
<style>
  .btn-row{padding:.375rem;border-radius:.5rem}
  .tab-btn[data-active="true"]{background:#4f46e5;color:#fff}
  .tab-panel.hidden{display:none}
</style>

{{!-- Minimal client-side behavior (no framework) --}}
<script>
/* ===== Utilities ===== */
const qs  = (s, r=document) => r.querySelector(s);
const qsa = (s, r=document) => [...r.querySelectorAll(s)];
const api = (url, opts={}) => fetch(url, { headers:{'Content-Type':'application/json'}, ...opts });

/* ===== Constants (type labels from <select>) ===== */
const TYPE_LABELS = (() => {
  const map = {};
  qsa('#filter-type option').forEach(o => {
    if (o.value !== '') map[o.value] = o.textContent.trim();
  });
  return map;
})();

/* ===== Drawer: user editor ===== */
const userDrawer   = qs('#user-drawer');
const userBackdrop = qs('[data-backdrop]', userDrawer);
const userPanel    = userBackdrop?.nextElementSibling;

const setDrawerOpen = (open) => {
  userDrawer.classList.toggle('hidden', !open);
  requestAnimationFrame(() => {
    userBackdrop.style.opacity = open ? '1' : '0';
    userPanel.style.transform  = open ? 'translateX(0)' : 'translateX(100%)';
  });
};

const setTab = (name) => {
  qsa('.tab-btn', userDrawer).forEach(b => b.setAttribute('data-active', b.dataset.tab === name));
  qsa('.tab-panel', userDrawer).forEach(p => p.classList.toggle('hidden', p.id !== 'tab-' + name));
};

const toast = (msg, ok=true) => {
  const t = qs('#drawer-toast');
  t.textContent = msg;
  t.className = ok ? 'text-sm text-emerald-400' : 'text-sm text-rose-400';
  setTimeout(()=>{ t.textContent=''; t.className='text-sm text-gray-400'; }, 2500);
};

/* ===== API loaders ===== */
async function loadUser(userId){
  const res = await api(`/api/users/${userId}`);
  if(!res.ok) throw new Error('Не удалось загрузить пользователя');
  return res.json();
}

/* ===== Fillers ===== */
function fillProfile(u){
  qs('#f-id').value = u.id ?? '';
  qs('#f-name').value = u.name ?? '';
  qs('#f-kaf').value  = u.kaf ?? '';
  qs('#f-type').value = u.type ?? '';
  qs('#f-status').checked = !!u.status;
  qs('#f-pin').value  = u.pin ?? '';
  qs('#drawer-title').textContent = u.id ? 'Редактировать пользователя' : 'Новый пользователь';
  qs('#drawer-sub').textContent = 'ID: ' + (u.id ?? '—');
}
function clearRoles(){ qsa('.role-checkbox', userDrawer).forEach(cb => (cb.checked = false)); }
function fillRoles(rights){
  const key = ({srv_id, role_id}) => `srv:${srv_id}|role:${role_id}`;
  const set = new Set((rights||[]).map(key));
  qsa('.role-checkbox', userDrawer).forEach(cb => {
    const k = `srv:${cb.dataset.srvId}|role:${cb.dataset.roleId}`;
    cb.checked = set.has(k);
  });
}
function clearLogins(){
  qsa('#logins-tbody tr', userDrawer).forEach(tr => {
    qs('.login-input', tr).value = '';
    qs('.pass-input', tr).value  = '';
  });
}
// logins = [{ srv_id, login, pass }]
function fillLogins(logins) {
  const lmap = new Map((logins || []).map(l => [String(l.srv_id), l.login || '']));
  const pmap = new Map((logins || []).map(l => [String(l.srv_id), l.pass  || '']));

  qsa('#logins-tbody tr', userDrawer).forEach(tr => {
    const k = tr.dataset.srvId;
    qs('.login-input', tr).value = lmap.get(k) || '';
    qs('.pass-input',  tr).value = pmap.get(k) || '';
  });
}

/* ===== Table row helpers (update UI immediately) ===== */
const tbody = qs('#users-tbody');

function typeNameById(id){
  return TYPE_LABELS[String(id)] || '—';
}

function renderStatusBadge(status){
  if (Number(status)) {
    return `
      <span class="inline-flex items-center gap-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Активен
      </span>`;
  }
  return `
      <span class="inline-flex items-center gap-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 px-2 py-0.5 text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Заблокирован
      </span>`;
}

function rowHTML(u){
  const initial = (u.name||'').trim().charAt(0) || '?';
  return `
  <tr class="hover:bg-gray-800/50 transition"
      data-user-id="${u.id}"
      data-user-name="${u.name||''}"
      data-user-kaf="${u.kaf||''}"
      data-user-type="${u.type||0}"
      data-user-status="${u.status||0}"
      data-user-pin="${u.pin||''}">
    <td class="px-4 py-3">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-indigo-600/20 flex items-center justify-center text-indigo-300 text-sm font-semibold">${initial}</div>
        <div class="min-w-0">
          <div class="text-sm font-medium text-gray-100 truncate">${u.name||''}</div>
          <div class="text-xs text-gray-500">ID: ${u.id}</div>
        </div>
      </div>
    </td>
    <td class="px-4 py-3 text-sm text-gray-300">${u.kaf||''}</td>
    <td class="px-4 py-3 text-sm">
      <span class="inline-flex items-center rounded-md bg-gray-800 border border-gray-700 px-2 py-0.5 text-gray-200 text-xs">${typeNameById(u.type)}</span>
    </td>
    <td class="px-4 py-3">${renderStatusBadge(u.status)}</td>
    <td class="px-4 py-3 font-mono text-sm text-gray-200">${u.pin||''}</td>
    <td class="px-4 py-3">
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn-row open-drawer" data-open-tab="profile" aria-label="Редактировать профиль">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M4 21h4l11-11a2.828 2.828 0 1 0-4-4L4 17v4Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="btn-row open-drawer" data-open-tab="roles" aria-label="Права">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M12 3l9 4.5v9L12 21 3 16.5v-9L12 3Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="btn-row open-drawer" data-open-tab="logins" aria-label="Логины">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-gray-300 hover:text-white"><path d="M4 7a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Zm0 10a3 3 0 0 1 3-3h10a3 3 0 1 1 0 6H7a3 3 0 0 1-3-3Z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="btn-row text-rose-400 hover:text-rose-300" data-action="delete" aria-label="Удалить">
          <svg viewBox="0 0 24 24" class="w-5 h-5"><path d="M5 7h14M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m1 0v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7h10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </td>
  </tr>`;
}

function updateRowUI(u){
  let tr = qs(`#users-tbody tr[data-user-id="${u.id}"]`);
  if (!tr) {
    // добавляем новую строку
    tbody.insertAdjacentHTML('afterbegin', rowHTML(u));
    return;
  }
  // datasets
  tr.dataset.userName   = u.name || '';
  tr.dataset.userKaf    = u.kaf  || '';
  tr.dataset.userType   = String(u.type || 0);
  tr.dataset.userStatus = String(u.status || 0);
  tr.dataset.userPin    = u.pin || '';

  // Имя + ID
  const nameEl = qs('.text-sm.font-medium', tr);
  if (nameEl) nameEl.textContent = u.name || '';
  const idEl = qsa('div.text-xs.text-gray-500', tr).find(d => d.textContent.startsWith('ID:'));
  if (idEl) idEl.textContent = `ID: ${u.id}`;

  // Подразделение
  const kafTd = tr.children[1];
  if (kafTd) kafTd.textContent = u.kaf || '';

  // Тип
  const typeTd = tr.children[2];
  if (typeTd) {
    const badge = qs('span', typeTd);
    if (badge) badge.textContent = typeNameById(u.type);
  }

  // Статус
  const statusTd = tr.children[3];
  if (statusTd) statusTd.innerHTML = renderStatusBadge(u.status);

  // PIN
  const pinTd = tr.children[4];
  if (pinTd) pinTd.textContent = u.pin || '';
}

/* ===== Open drawer (delegated) ===== */
tbody?.addEventListener('click', async (e) => {
  const btn = e.target.closest('.open-drawer');
  if (!btn) return;
  const tr = btn.closest('tr');
  const id = tr?.dataset.userId;
  const tab = btn.dataset.openTab || 'profile';
  setDrawerOpen(true);
  setTab(tab);
  try{
    const data = await loadUser(id);
    fillProfile(data.user || {});
    clearRoles();  fillRoles(data.rights || []);
    clearLogins(); fillLogins(data.logins || []);
  }catch(err){
    toast(err.message, false);
  }
});

/* ===== Create new user ===== */
function openCreate(){
  setDrawerOpen(true);
  setTab('profile');
  fillProfile({ id:null, name:'', kaf:'', type:'', status:1, pin:'' });
  clearRoles(); clearLogins();
}
qs('#btn-create-user')?.addEventListener('click', openCreate);
qs('#btn-create-user-empty')?.addEventListener('click', openCreate);

/* ===== Close drawer ===== */
qsa('[data-close]', userDrawer).forEach(b => b.addEventListener('click', ()=> setDrawerOpen(false)));
userBackdrop?.addEventListener('click', ()=> setDrawerOpen(false));
document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') setDrawerOpen(false); });

/* ===== Tabs ===== */
qsa('.tab-btn', userDrawer).forEach(b => b.addEventListener('click', ()=> setTab(b.dataset.tab)));

/* ===== Generators ===== */
qs('#btn-gen-pin')?.addEventListener('click', ()=>{
  // 7-значный PIN (цифры)
  let pin = '';
  const arr = new Uint32Array(7);
  crypto.getRandomValues(arr);
  pin = Array.from(arr, n => (n % 10)).join('');
  qs('#f-pin').value = pin;
});

userDrawer.addEventListener('click', (e)=>{
  const btn = e.target.closest('.gen-pass');
  if (!btn) return;
  const tr = btn.closest('tr');
  const p = Array.from(crypto.getRandomValues(new Uint8Array(12)))
                  .map(n=>('0'+(n%36).toString(36)).slice(-1)).join('');
  qs('.pass-input', tr).value = p;
});

/* ===== Save current tab ===== */
qs('#btn-save-current')?.addEventListener('click', async ()=>{
  const active = qs('.tab-btn[data-active="true"]')?.dataset.tab || 'profile';
  const idVal  = qs('#f-id').value || null;

  try{
    if(active === 'profile'){
      const body = {
        id: idVal ? Number(idVal) : null,
        name: qs('#f-name').value.trim(),
        kaf:  qs('#f-kaf').value.trim(),
        type: Number(qs('#f-type').value || 0),
        status: qs('#f-status').checked ? 1 : 0,
        pin:  qs('#f-pin').value.trim()
      };
      const res = await api('/api/users' + (idVal ? `/${idVal}` : ''), {
        method: idVal ? 'PUT' : 'POST',
        body: JSON.stringify(body)
      });
      if(!res.ok) throw new Error('Ошибка сохранения профиля');
      const data = await res.json().catch(()=> ({}));

      // если новый пользователь — получим id от бэка и перезагрузим данные
      const newId = idVal ? Number(idVal) : Number(data.id);
      if (!newId) {
        // fallback: просто уведомим
        toast('Профиль сохранён');
        return;
      }

      // подтягиваем свежие данные и обновляем UI
      const fresh = await loadUser(newId);
      const u = fresh.user || { id:newId, ...body };
      // обновляем форму (на случай автозамены / нормализации)
      fillProfile(u);
      // обновляем таблицу
      updateRowUI(u);

      toast('Профиль сохранён');
    }

    if(active === 'roles'){
      const uid = Number(qs('#f-id').value);
      if(!uid) throw new Error('Сначала сохраните профиль');
      const pairs = qsa('.role-checkbox:checked', userDrawer).map(cb => ({
        srv_id: Number(cb.dataset.srvId),
        role_id: Number(cb.dataset.roleId)
      }));
      const res = await api(`/api/users/${uid}/rights`, {
        method:'PUT',
        body: JSON.stringify({ pairs })
      });
      if(!res.ok) throw new Error('Ошибка сохранения ролей');
      toast('Права сохранены');
    }

    if(active === 'logins'){
      const uid = Number(qs('#f-id').value);
      if(!uid) throw new Error('Сначала сохраните профиль');
      const rows = qsa('#logins-tbody tr', userDrawer).map(tr => ({
        srv_id: Number(tr.dataset.srvId),
        login:  qs('.login-input', tr).value.trim(),
        new_password: qs('.pass-input', tr).value
      }));
      const res = await api(`/api/users/${uid}/logins`, {
        method:'PUT',
        body: JSON.stringify({ rows })
      });
      if(!res.ok) throw new Error('Ошибка сохранения логинов');
      qsa('.pass-input', userDrawer).forEach(i => i.value = '');
      toast('Логины сохранены');
    }
  }catch(err){
    toast(err.message, false);
  }
});

/* ===== Delete (delegated) ===== */
tbody?.addEventListener('click', async (e)=>{
  const btn = e.target.closest('button[data-action="delete"]');
  if (!btn) return;
  const tr = btn.closest('tr');
  const id = tr?.dataset.userId;
  if (!id) return;
  if (!confirm('Удалить пользователя #' + id + '?')) return;
  const res = await api(`/api/users/${id}`, { method:'DELETE' });
  if (res.ok) tr.remove();
  else alert('Не удалось удалить пользователя');
});

/* ===== Filters & search ===== */
function applyFilters(){
  const q  = (qs('#user-search')?.value || '').trim().toLowerCase();
  const st = qs('#filter-status')?.value || '';
  const tp = qs('#filter-type')?.value || '';

  qsa('#users-tbody tr').forEach(tr => {
    const name = tr.dataset.userName?.toLowerCase() || '';
    const pin  = tr.dataset.userPin?.toLowerCase()  || '';
    const passQ  = !q || name.includes(q) || pin.includes(q);
    const passSt = !st || tr.dataset.userStatus === st;
    const passTp = !tp || tr.dataset.userType   === tp;
    tr.classList.toggle('hidden', !(passQ && passSt && passTp));
  });
}
qs('#user-search')?.addEventListener('input',  applyFilters);
qs('#filter-status')?.addEventListener('change', applyFilters);
qs('#filter-type')?.addEventListener('change',  applyFilters);

</script>

<!-- ===== Drawer: Services ↔ Roles panel (unchanged logic, with save refresh) ===== -->
<script>
(function(){
  const openBtn  = document.getElementById('btn-srvs-roles');
  const drawer   = document.getElementById('srvroles-drawer');
  if(!drawer) return;

  const backdrop = drawer.querySelector('[data-backdrop]');
  const panel    = backdrop.nextElementSibling;
  const tbody    = drawer.querySelector('#srvroles-tbody');
  const search   = drawer.querySelector('#srvroles-search');
  const saveBtns = [document.getElementById('srvroles-save'), document.getElementById('srvroles-save-bottom')].filter(Boolean);

  function openDrawer(){
    drawer.classList.remove('hidden');
    requestAnimationFrame(()=>{
      backdrop.style.opacity='1';
      panel.style.transform='translateX(0)';
      initChecks();
    });
  }
  function closeDrawer(){
    backdrop.style.opacity='0';
    panel.style.transform='translateX(100%)';
    setTimeout(()=>drawer.classList.add('hidden'), 200);
  }

  openBtn?.addEventListener('click', openDrawer);
  drawer.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', closeDrawer));
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && !drawer.classList.contains('hidden')) closeDrawer(); });

  function initChecks(){
    tbody.querySelectorAll('tr').forEach(tr=>{
      const allowed = (tr.dataset.allowedRoles || '').split(',').filter(Boolean);
      const set = new Set(allowed);
      tr.querySelectorAll('.srv-role-checkbox').forEach(cb=>{ cb.checked = set.has(cb.dataset.roleId); });
    });
  }

  tbody.addEventListener('click', (e)=>{
    const btn = e.target.closest('.sel-all, .sel-none');
    if(!btn) return;
    const tr = btn.closest('tr');
    tr.querySelectorAll('.srv-role-checkbox').forEach(cb=>{ cb.checked = btn.classList.contains('sel-all'); });
  });

  search?.addEventListener('input', ()=>{
    const q = search.value.trim().toLowerCase();
    tbody.querySelectorAll('tr').forEach(tr=>{
      const name = (tr.dataset.srvName || '').toLowerCase();
      tr.classList.toggle('hidden', q && !name.includes(q));
    });
  });

  async function save(){
    const pairs = [];
    tbody.querySelectorAll('tr').forEach(tr=>{
      const srvId = Number(tr.dataset.srvId);
      tr.querySelectorAll('.srv-role-checkbox:checked').forEach(cb=>{
        pairs.push({ srv_id: srvId, role_id: Number(cb.dataset.roleId) });
      });
    });
    try{
      const res = await fetch('/api/srvs-roles', {
        method: 'PUT',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ pairs })
      });
      if(!res.ok) throw new Error('Ошибка сохранения');
      closeDrawer();
      // опционально: перезагрузить справочник в памяти/на странице (если нужно)
    }catch(err){
      alert(err.message);
    }
  }
  saveBtns.forEach(b => b?.addEventListener('click', save));
})();
</script>
