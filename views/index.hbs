<main class="min-h-screen bg-slate-50 pt-16 text-slate-900">
  <div class="mx-auto grid max-w-7xl gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[18rem_1fr] lg:px-8">
    <aside class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <div class="mb-4 flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-white">
          <svg class="h-5 w-5" aria-hidden="true"><use href="/icons/lucide.svg#info"></use></svg>
        </span>
        <div>
          <h1 class="text-base font-semibold">Информация</h1>
          <p class="text-sm text-slate-500">важные объявления</p>
        </div>
      </div>

      <div class="space-y-2">
        {{#each info}}
          <details class="group rounded-lg border border-slate-200 bg-slate-50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-medium text-slate-800">
              <span>{{title}}</span>
              <svg class="h-4 w-4 shrink-0 text-slate-400 transition group-open:rotate-180" aria-hidden="true"><use href="/icons/lucide.svg#chevron-down"></use></svg>
            </summary>
            <div class="border-t border-slate-200 px-3 py-3 text-sm leading-6 text-slate-600">
              {{{content}}}
            </div>
          </details>
        {{/each}}
      </div>

      <div class="mt-4 border-t border-slate-200 pt-4">
        {{#if auth}}
          <a href="/logout" class="inline-flex min-h-[40px] w-full items-center justify-center gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100">
            <svg class="h-4 w-4" aria-hidden="true"><use href="/icons/lucide.svg#log-out"></use></svg>
            Выйти
          </a>
        {{else}}
          <button type="button" data-open-login class="inline-flex min-h-[40px] w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">
            <svg class="h-4 w-4" aria-hidden="true"><use href="/icons/lucide.svg#log-in"></use></svg>
            Войти
          </button>
        {{/if}}
      </div>
    </aside>

    <section>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {{#each menu}}
          <a href="{{this.link}}" class="group overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <div class="aspect-[4/3] bg-slate-100">
              <img src="img/{{this.pic}}" alt="{{this.text}}" class="h-full w-full object-cover transition duration-200 group-hover:scale-[1.02]">
            </div>
            <div class="flex min-h-[76px] items-center justify-center px-3 py-4 text-center text-sm font-semibold text-slate-800">
              {{{this.text}}}
            </div>
          </a>
        {{/each}}
      </div>
    </section>
  </div>
</main>
