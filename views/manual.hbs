<main class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
  <h1 class="text-2xl font-semibold text-slate-950">Инструкции</h1>
  {{#if files.length}}
    <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {{#each files}}
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          {{#if (or (eq format "PDF") (eq format "MP4") (eq format "WEBM"))}}
            <a href="{{url}}" class="min-w-0 break-words font-medium text-blue-700 hover:underline">{{name}}</a>
            <a href="{{url}}" download aria-label="Скачать {{name}}" class="shrink-0 rounded-lg px-2 py-2 text-sm text-slate-600 hover:bg-slate-100">Скачать</a>
          {{else}}
            <a href="{{url}}" download class="min-w-0 break-words font-medium text-blue-700 hover:underline">{{name}}</a>
            <span class="shrink-0 text-sm text-slate-500">{{format}}</span>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="mt-3 text-slate-600">Пока нет опубликованных инструкций.</p>
  {{/if}}
</main>
