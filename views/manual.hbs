<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-6 lg:flex-row">
    <aside class="w-full rounded-lg border border-slate-700 bg-gray-800 p-4 text-white shadow-lg lg:w-1/3">
      <ul class="max-h-[500px] space-y-2 overflow-y-auto text-sm">
        {{#each files}}
          <li>
            <a id="{{this}}"
               href="#"
               class="manual-file-link block rounded-lg px-4 py-2 leading-snug break-words transition hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
              {{this}}
            </a>
          </li>
        {{/each}}
      </ul>
    </aside>

    <div class="w-full lg:flex-1">
      <iframe id="frame"
              src=""
              class="h-[80vh] w-full rounded-lg border border-gray-700 bg-white text-black shadow-lg dark:bg-gray-900 dark:text-white">
        не удалось показать документ
      </iframe>
    </div>
  </div>
</section>

<script>
(() => {
  const frame = document.getElementById('frame');
  document.querySelectorAll('.manual-file-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const filename = link.id;
      if (frame && filename) frame.src = `docs/${filename}`;
    });
  });
})();
</script>
