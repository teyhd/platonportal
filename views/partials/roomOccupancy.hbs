<section class="room-occ" data-room-occupancy aria-labelledby="room-occ-title">
  <div class="room-occ__summary">
    <button class="room-occ__toggle" data-toggle type="button" aria-expanded="false" aria-controls="room-occ-body">
      <span id="room-occ-title">Кабинеты</span>
      <span class="room-occ__chevron" aria-hidden="true"></span>
    </button>
    <span class="room-occ__selected" data-selected hidden></span>
    <ul class="room-occ__preview" data-preview aria-label="Номера и статусы кабинетов" tabindex="-1" hidden></ul>
    <span class="room-occ__preview-note" data-preview-note role="status">Загрузка…</span>
  </div>
  <div class="room-occ__body" id="room-occ-body" hidden>
    <header class="room-occ__header">
      <div class="room-occ__picker" role="group" aria-label="Момент проверки по московскому времени">
        <button class="room-occ__pick-button" type="button" data-open-picker aria-haspopup="dialog" aria-controls="room-occ-picker">Дата и время</button>
        <button class="room-occ__reset" data-reset type="button" aria-label="Сейчас — сбросить дату и время" disabled>Сейчас</button>
      </div>
      <div class="room-occ__readout">
        <p class="room-occ__time" data-time>По расписанию</p>
        <div class="room-occ__totals" data-totals hidden>
          <strong class="room-occ__total" data-kind="free"></strong>
          <strong class="room-occ__total" data-kind="busy"></strong>
          <strong class="room-occ__total" data-kind="soon" hidden></strong>
          <strong class="room-occ__total" data-kind="unknown" hidden></strong>
        </div>
      </div>
    </header>
    <ul class="room-occ__legend" data-legend aria-label="Статусы кабинетов" hidden>
      <li class="room-occ__legend-item" data-kind="free"><span class="room-occ__legend-key" aria-hidden="true"></span>Свободен</li>
      <li class="room-occ__legend-item" data-kind="busy"><span class="room-occ__legend-key" aria-hidden="true"></span>Занят</li>
      <li class="room-occ__legend-item" data-kind="soon"><span class="room-occ__legend-key" aria-hidden="true"></span>Скоро освободится</li>
      <li class="room-occ__legend-item" data-kind="short"><span class="room-occ__legend-key" aria-hidden="true"></span>Свободен ненадолго</li>
    </ul>
    <div data-floors></div>
    <p class="room-occ__message" data-message role="status">Загрузка расписания…</p>
    <button class="room-occ__retry" data-retry type="button" hidden>Обновить</button>
  </div>
  <dialog class="room-occ__dialog" id="room-occ-picker" data-picker aria-labelledby="room-occ-picker-title">
    <form data-picker-form autocomplete="off">
      <h3 id="room-occ-picker-title">Дата и время</h3>
      <div class="room-occ__calendar">
        <div class="room-occ__month">
          <button type="button" data-month-back aria-label="Предыдущий месяц">‹</button>
          <p data-month-label aria-live="polite"></p>
          <button type="button" data-month-forward aria-label="Следующий месяц">›</button>
        </div>
        <div class="room-occ__weekdays" aria-hidden="true">
          <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
        </div>
        <div class="room-occ__days" data-days role="group" aria-label="День месяца"></div>
      </div>
      <div class="room-occ__clock" role="group" aria-labelledby="room-occ-clock-label">
        <span id="room-occ-clock-label">Время (МСК)</span>
        <input type="text" data-hour aria-label="Часы" inputmode="numeric" maxlength="2" required pattern="[01]?[0-9]|2[0-3]">
        <span class="room-occ__separator" aria-hidden="true">:</span>
        <input type="text" data-minute aria-label="Минуты" inputmode="numeric" maxlength="2" required pattern="[0-5]?[0-9]">
      </div>
      <div class="room-occ__picker-actions">
        <button type="button" data-picker-cancel>Отмена</button>
        <button class="room-occ__apply" type="submit">Показать</button>
      </div>
    </form>
  </dialog>
  <div class="room-occ__tooltip" id="room-occ-issue" data-issue-tooltip role="tooltip" hidden></div>
</section>
