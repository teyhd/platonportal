</script>

<script>


  $(document).ready(function () {
      const g=document.getElementById('privacyGroup');if(!g)return;
const btns=[...g.querySelectorAll('.seg')],hint=document.getElementById('privacyHint'),inp=document.getElementById('privacyInput');
const texts={public:'Все ученики видят вашу комнату.',private:'Доступ только по ссылке.'};
function set(v){inp.value=v;btns.forEach(b=>{const on=b.dataset.value===v;b.setAttribute('aria-checked',on);
b.classList.toggle('active',on);
b.className='seg inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm transition '+
(on?'bg-blue-600 text-white':'bg-gray-700 text-gray-200 hover:bg-gray-600');
});hint.textContent=texts[v]||'';}
btns.forEach(b=>b.addEventListener('click',()=>set(b.dataset.value)));
g.addEventListener('keydown',e=>{const i=btns.findIndex(b=>b.getAttribute('aria-checked')==='true');
if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();
const n=e.key==='ArrowRight'?(i+1)%btns.length:(i-1+btns.length)%btns.length;set(btns[n].dataset.value);btns[n].focus();}});
set('public');

  // ссылки для копирования и перехода задаются отдельно
  let copyUrl = '';
  let joinUrl = '';

  function openModal2(copy, join,acc) {
    $("#requireAuth").prop("checked", String(acc.need_auth).toLowerCase() == "true").trigger("change");
   // $("#requireAuth").val() 
    console.log(acc)
    console.log(String(acc.pub).toLowerCase() ,acc.pub)
    if (String(acc.pub).toLowerCase() == "true"){
      s//etPrivacy("public");
      set('public')
    } else {
      //setPrivacy("private");
      set('private')
    }

    copyUrl = copy || '';
    joinUrl = join || '';
    document.getElementById('copy-link').value = copyUrl;
    document.getElementById('modal2').classList.remove('hidden');
  }
  function closeModal2() {
    document.getElementById('modal2').classList.add('hidden');
  }

  // кнопки
  const copyBtn  = document.getElementById('copyBtn');
  const joinBtn  = document.getElementById('joinBtn');
  const closeBtn = document.getElementById('closeBtn');
  const closeX   = document.getElementById('closeModal');
  const overlay  = document.getElementById('modal2-overlay');
  const toast    = document.getElementById('toast');

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyUrl);
    } catch {
      const ta = document.getElementById('copy-link');
      ta.select(); document.execCommand('copy');
    }
    toast.classList.remove('invisible','opacity-0');
    setTimeout(()=>toast.classList.add('opacity-0'),1200);
    setTimeout(()=>toast.classList.add('invisible'),1600);
  });

  joinBtn.addEventListener('click', () => {
    if (joinUrl) window.open(joinUrl,'_blank','noopener');
  });
  [closeBtn, closeX, overlay].forEach(el=>el.addEventListener('click', closeModal2));
  document.addEventListener('keydown', e=>{if(e.key==='Escape') closeModal2();});

  // Отслеживаем клик по ссылке с href="#lesson"
  $('a[href="#lesson"]').on("click", function (e) {
    e.preventDefault(); // отменяем переход по ссылке
    $.ajax({
      type: 'GET',
      url: '/getvlinks',
      contentType: 'application/json',
      //data: JSON.stringify(payload),
      xhrFields: {
        withCredentials: true
      },
      success: function (datas) {
        console.log(datas);
        datas.roomid = window.location.href.split('#')[0] + datas.roomid
        console.log(datas.acc);
        openModal2(datas.roomid, datas.link, datas.acc);
      },
      error: function (jqXHR, textStatus, errorThrown) {
        console.error("Ошибка отправки:", textStatus, errorThrown);
      }
    });
   // 

    
  });

  
  $("#openModal").on("click", function () {
    $("#modal").removeClass("hidden");
  });

  $("#closeModal").on("click", function () {
    $("#modal").addClass("hidden");
  });
});
</script>

<script>
$(function(){
  function sendState(){
    let pub = $("#privacyInput").val() === "public";
    let needAuth = $("#requireAuth").is(":checked");
    
    $.ajax({
      type: 'GET',
      url: `/getvlinks`,
      data: {
        pub: pub,
        need_auth: needAuth
      },
      contentType: 'application/json',
      xhrFields: { withCredentials: true },
      success: function(res){ 
        console.log("Сервер ответил:", res); 
      },
      error: function(err){ 
        console.error("Ошибка:", err); 
      }
    });
  }

  // событие на сегменте «Публичная/Частная»
  $("#privacyGroup .seg").on("click", function(){
    $("#privacyInput").val($(this).data("value"));
    sendState();
  });

  // событие на чекбоксе
  $("#requireAuth").on("change", function(){
    sendState();
  });
});
</script>

<!-- Модалка: Активные комнаты -->
<div id="roomsModal" class="fixed inset-0 z-[100] hidden">
  <div id="roomsBackdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div role="dialog" aria-modal="true" aria-labelledby="roomsTitle"
       class="relative mx-auto my-10 w-full max-w-2xl">
    <div class="bg-gray-800 text-white rounded-2xl shadow-xl p-5 md:p-6 relative">
      <button id="roomsClose"
              class="absolute top-3 right-3 h-9 w-9 flex items-center justify-center rounded-full text-gray-400 hover:text-white hover:bg-white/10"
              aria-label="Закрыть">
        &times;
      </button>

      <h3 id="roomsTitle" class="text-xl font-semibold mb-1">Активные комнаты</h3>

      <!-- Список комнат -->
      <div id="roomsList" class="grid sm:grid-cols-2 gap-3">
        <!-- Элементы подставляются скриптом -->
      </div>

      <!-- Пустой список -->
      <div id="roomsEmpty" class="hidden text-sm text-gray-400 text-center py-6">
        Сейчас нет активных комнат.
      </div>

      <!-- Нижние кнопки -->
      <div class="mt-4 flex justify-end">
        <button id="roomsClose2"
                class="px-4 py-2 rounded-xl bg-gray-700 hover:bg-gray-600 font-medium">
          Закрыть
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  $('a[href="#room"]').on("click", function (e) {
    let rooms = []
    e.preventDefault(); // отменяем переход по ссылке
    $.ajax({
      type: 'GET',
      url: '/rooms',
      contentType: 'application/json',
      xhrFields: {
        withCredentials: true
      },
      success: function (datas) {
        console.log(datas);
        try {
          datas.rooms.forEach(element => {
            let romid = element?.room_info?.room_id ?? false
            const isPublic = (()=>{
            const val = datas?.acc?.[element?.room_info?.room_id]?.pub;
            return val === undefined ? true : String(val).toLowerCase() === "true";
          })();
            if (isPublic) rooms.push({roomid: element.room_info.room_id, title: element.room_info.room_title,peops:element.room_info.joined_participants});
          });
        } catch (error) {
          console.error(error);
        }
        openRoomsModal(rooms) ;
        //datas.roomid = window.location.href.split('#')[0] + datas.roomid
        //openModal2(datas.roomid, datas.link, datas.acc);
      },
      error: function (jqXHR, textStatus, errorThrown) {
        console.error("Ошибка отправки:", textStatus, errorThrown);
      }
    });
   // 

    
  });

  const modal   = document.getElementById('roomsModal');
  const list    = document.getElementById('roomsList');
  const emptyEl = document.getElementById('roomsEmpty');
  const closeEl = document.getElementById('roomsClose');
  const close2  = document.getElementById('roomsClose2');
  const back    = document.getElementById('roomsBackdrop');

  function renderRooms(rooms = []) {
    list.innerHTML = '';
    if (!rooms.length) {
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');

    // rooms: [{roomid, title?}]
    rooms.forEach(r => {
      const rid   = String(r.roomid ?? '').trim();
      const title = (r.title ?? `Комната ${rid || 'без ID'}`).toString();
      const url   = `/jointo?roomid=${encodeURIComponent(rid)}`;
      const peops = r.peops || 0;
      const a = document.createElement('a');
      a.href = url;
      a.className = [
        "block rounded-xl border border-gray-700 bg-gray-900/60 hover:bg-gray-900",
        "transition shadow-sm hover:shadow-md p-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
      ].join(' ');

      a.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="mt-0.5 h-8 w-8 rounded-lg bg-blue-600/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 6a6 6 0 00-6 6v5h12v-5a6 6 0 00-6-6Z" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="font-medium truncate">${escapeHtml(title)}</div>
            <div class="text-xs text-gray-400 mt-0.5">roomid: <span class="font-mono">${escapeHtml(rid)}</span></div>
            <div class="mt-2 inline-flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-full text-xs bg-gray-700 text-gray-200">Участников: ${escapeHtml(peops)}</span>
              <span class="px-2 py-0.5 rounded-full text-xs bg-blue-600/20 text-blue-300">активна</span>
            </div>
          </div>
        </div>
      `;
      list.appendChild(a);
    });
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function openRoomsModal(rooms) {
    renderRooms(Array.isArray(rooms) ? rooms : []);
    modal.classList.remove('hidden');
    // ловим Esc
    document.addEventListener('keydown', escClose, { once: true });
  }

  function closeRoomsModal() {
    modal.classList.add('hidden');
  }

  function escClose(e) {
    if (e.key === 'Escape') closeRoomsModal();
  }

  // клики на фон и кнопки
  back.addEventListener('click', closeRoomsModal);
  closeEl.addEventListener('click', closeRoomsModal);
  close2.addEventListener('click', closeRoomsModal);

  // Экспортируем функцию в глобальную область
  window.openRoomsModal  = openRoomsModal;
  window.closeRoomsModal = closeRoomsModal;
})();
</script>
