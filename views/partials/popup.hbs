<script>
(() => {
  $('a[href="#room"]').on("click", function (e) {
    let rooms = []
    e.preventDefault(); // отменяем переход по ссылке
    $.ajax({
      type: 'GET',
      url: '/rooms',
      contentType: 'application/json',
      xhrFields: {
        withCredentials: true
      },
      success: function (datas) {
        console.log(datas);
        try {
          datas.rooms.forEach(element => {
            let romid = element?.room_info?.room_id ?? false
            const isPublic = (()=>{
            const val = datas?.acc?.[element?.room_info?.room_id]?.pub;
            return val === undefined ? true : String(val).toLowerCase() === "true";
          })();
            if (isPublic) rooms.push({roomid: element.room_info.room_id, title: element.room_info.room_title,peops:element.room_info.joined_participants});
          });
        } catch (error) {
          console.error(error);
        }
        openRoomsModal(rooms) ;
        //datas.roomid = window.location.href.split('#')[0] + datas.roomid
        //openModal2(datas.roomid, datas.link, datas.acc);
      },
      error: function (jqXHR, textStatus, errorThrown) {
        console.error("Ошибка отправки:", textStatus, errorThrown);
      }
    });
   // 

    
  });

  const modal   = document.getElementById('roomsModal');
  const list    = document.getElementById('roomsList');
  const emptyEl = document.getElementById('roomsEmpty');
  const closeEl = document.getElementById('roomsClose');
  const close2  = document.getElementById('roomsClose2');
  const back    = document.getElementById('roomsBackdrop');

  function renderRooms(rooms = []) {
    list.innerHTML = '';
    if (!rooms.length) {
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');

    // rooms: [{roomid, title?}]
    rooms.forEach(r => {
      const rid   = String(r.roomid ?? '').trim();
      const title = (r.title ?? `Комната ${rid || 'без ID'}`).toString();
      const url   = `/jointo?roomid=${encodeURIComponent(rid)}`;
      const peops = r.peops || 0;
      const a = document.createElement('a');
      a.href = url;
      a.className = [
        "block rounded-xl border border-gray-700 bg-gray-900/60 hover:bg-gray-900",
        "transition shadow-sm hover:shadow-md p-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
      ].join(' ');

      a.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="mt-0.5 h-8 w-8 rounded-lg bg-blue-600/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 6a6 6 0 00-6 6v5h12v-5a6 6 0 00-6-6Z" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="font-medium truncate">${escapeHtml(title)}</div>
            <div class="text-xs text-gray-400 mt-0.5">roomid: <span class="font-mono">${escapeHtml(rid)}</span></div>
            <div class="mt-2 inline-flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-full text-xs bg-gray-700 text-gray-200">Участников: ${escapeHtml(peops)}</span>
              <span class="px-2 py-0.5 rounded-full text-xs bg-blue-600/20 text-blue-300">активна</span>
            </div>
          </div>
        </div>
      `;
      list.appendChild(a);
    });
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function openRoomsModal(rooms) {
    renderRooms(Array.isArray(rooms) ? rooms : []);
    modal.classList.remove('hidden');
    // ловим Esc
    document.addEventListener('keydown', escClose, { once: true });
  }

  function closeRoomsModal() {
    modal.classList.add('hidden');
  }

  function escClose(e) {
    if (e.key === 'Escape') closeRoomsModal();
  }

  // клики на фон и кнопки
  back.addEventListener('click', closeRoomsModal);
  closeEl.addEventListener('click', closeRoomsModal);
  close2.addEventListener('click', closeRoomsModal);

  // Экспортируем функцию в глобальную область
  window.openRoomsModal  = openRoomsModal;
  window.closeRoomsModal = closeRoomsModal;
})();
</script>

{{!-- Модальное окно списка онлайн-уроков /rooms --}}
<div
  id="roomsModal"
  class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-black/40"
>
  <div
    class="w-full sm:max-w-lg bg-white rounded-t-2xl sm:rounded-2xl shadow-lg flex flex-col max-h-[90vh]"
  >
    <div class="flex items-center justify-between px-4 py-3 border-b">
      <h2 class="text-base font-semibold text-gray-900">
        Онлайн-уроки
      </h2>
      <button
        type="button"
        class="rooms-modal-close p-2 -mr-2 text-gray-500 hover:text-gray-800 focus:outline-none"
        aria-label="Закрыть"
      >
        ✕
      </button>
    </div>

    <div id="roomsModalBody" class="p-4 overflow-y-auto text-sm text-gray-800 space-y-3">
      <div class="flex items-center gap-2 text-gray-500">
        <span class="inline-block h-4 w-4 border-2 border-t-transparent border-gray-400 rounded-full animate-spin"></span>
        <span>Загружаем список комнат…</span>
      </div>
    </div>

    <div class="px-4 pb-4 pt-2 border-t text-[11px] text-gray-500">
      Данные обновляются при каждом открытии окна.
    </div>
  </div>
</div>

<script>
// Модалка /rooms: мобильный "нижний лист" + центрирование на больших экранах
(function () {
  function ready(fn) {
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(fn, 0);
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  }

  ready(function () {
    var modal = document.getElementById('roomsModal');
    if (!modal) return;

    var bodyEl = document.getElementById('roomsModalBody');
    var closeButtons = modal.querySelectorAll('.rooms-modal-close');
    var backdropClickClose = true;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
    }

    // Закрытие по кнопке
    closeButtons.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        closeModal();
      });
    });

    // Закрытие по клику на фон
    modal.addEventListener('click', function (e) {
      if (!backdropClickClose) return;
      if (e.target === modal) {
        closeModal();
      }
    });

    // Закрытие по ESC
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeModal();
      }
    });

    function setLoadingState() {
      bodyEl.innerHTML =
        '<div class="flex items-center gap-2 text-gray-500">' +
        '  <span class="inline-block h-4 w-4 border-2 border-t-transparent border-gray-400 rounded-full animate-spin"></span>' +
        '  <span>Загружаем список комнат…</span>' +
        '</div>';
    }

    function renderRooms(data) {
      if (!data) {
        showError('Не удалось получить данные. Попробуйте ещё раз.');
        return;
      }

      // Вариант, если сервер явно говорит, что нет прав
      if (data.ok === false && data.message === 'forbidden') {
        bodyEl.innerHTML =
          '<p class="text-sm text-gray-700">Нет прав для просмотра комнат.</p>';
        return;
      }

      // Пытаемся найти массив комнат в ответе
      var rooms = data.rooms || data.room || data.data || [];
      if (!Array.isArray(rooms)) rooms = [];

      if (!rooms.length) {
        bodyEl.innerHTML =
          '<p class="text-sm text-gray-700">Сейчас нет активных комнат.</p>';
        return;
      }

      var html = '<div class="space-y-3">';
      rooms.forEach(function (item) {
        var info = item.room_info || item;
        if (!info) return;

        var title = info.room_title || info.title || 'Без названия';
        var roomId = info.room_id || info.id || '';
        var participants = info.joined_participants || info.participants || '0';
        var isRunning = Number(info.is_running || info.running || 0) === 1;

        html +=
          '<div class="border border-gray-200 rounded-xl px-3 py-2.5 flex items-center justify-between gap-3">' +
          '  <div class="min-w-0">' +
          '    <div class="text-sm font-medium text-gray-900 truncate">' + title + '</div>' +
          '    <div class="mt-0.5 flex items-center gap-2 text-[11px] text-gray-500">' +
          '      <span class="inline-flex items-center gap-1">' +
          '        <span class="h-1.5 w-1.5 rounded-full ' + (isRunning ? 'bg-emerald-500' : 'bg-gray-300') + '"></span>' +
          '        ' + (isRunning ? 'Идёт сейчас' : 'Завершена') +
          '      </span>' +
          '      <span>·</span>' +
          '      <span>Участников: ' + participants + '</span>' +
          '    </div>' +
          '  </div>';

        if (roomId && isRunning) {
          var link = '/jointo?roomid=' + encodeURIComponent(roomId);
          html +=
            '  <a href="' + link + '" ' +
            '     class="shrink-0 inline-flex items-center justify-center px-3 py-1.5 rounded-lg text-xs font-medium ' +
            '            bg-emerald-500 text-white hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-1">' +
            '    Перейти' +
            '  </a>';
        }

        html += '</div>';
      });
      html += '</div>';

      bodyEl.innerHTML = html;
    }

    function showError(message) {
      bodyEl.innerHTML =
        '<p class="text-sm text-red-600">' +
        (message || 'Не удалось загрузить список комнат. Попробуйте позже.') +
        '</p>';
    }

    function handleClick(e) {
      e.preventDefault();
      setLoadingState();
      openModal();

      fetch('/rooms', {
        method: 'GET',
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' }
      })
        .then(function (res) {
          if (!res.ok) {
            if (res.status === 403) {
              return { ok: false, message: 'forbidden' };
            }
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .then(function (data) {
          renderRooms(data);
        })
        .catch(function (err) {
          console.error(err);
          showError();
        });
    }

    // Привязка к ссылкам a[href="#lesson"]
    function bindLessonLinks() {
      if (window.jQuery) {
        // В стиле твоего примера: $('a[href="#lesson"]').on("click", ...)
        window.jQuery('a[href="#lesson"]').off('click.roomsModal').on('click.roomsModal', handleClick);
      } else {
        var links = document.querySelectorAll('a[href="#lesson"]');
        links.forEach(function (a) {
          a.addEventListener('click', handleClick);
        });
      }
    }

    bindLessonLinks();
  });
})();
</script>