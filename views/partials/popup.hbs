<script>


  $(document).ready(function () {
      const g=document.getElementById('privacyGroup');if(!g)return;
const btns=[...g.querySelectorAll('.seg')],hint=document.getElementById('privacyHint'),inp=document.getElementById('privacyInput');
const texts={public:'Все ученики видят вашу комнату.',private:'Доступ только по ссылке.'};
function set(v){inp.value=v;btns.forEach(b=>{const on=b.dataset.value===v;b.setAttribute('aria-checked',on);
b.classList.toggle('active',on);
b.className='seg inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm transition '+
(on?'bg-blue-600 text-white':'bg-gray-700 text-gray-200 hover:bg-gray-600');
});hint.textContent=texts[v]||'';}
btns.forEach(b=>b.addEventListener('click',()=>set(b.dataset.value)));
g.addEventListener('keydown',e=>{const i=btns.findIndex(b=>b.getAttribute('aria-checked')==='true');
if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();
const n=e.key==='ArrowRight'?(i+1)%btns.length:(i-1+btns.length)%btns.length;set(btns[n].dataset.value);btns[n].focus();}});
set('public');

  // ссылки для копирования и перехода задаются отдельно
  let copyUrl = '';
  let joinUrl = '';

  function openModal2(copy, join,acc) {
    $("#requireAuth").prop("checked", String(acc.need_auth).toLowerCase() == "true").trigger("change");
   // $("#requireAuth").val() 
    console.log(acc)
    console.log(String(acc.pub).toLowerCase() ,acc.pub)
    if (String(acc.pub).toLowerCase() == "true"){
      //etPrivacy("public");
      set('public')
    } else {
      //setPrivacy("private");
      set('private')
    }

    copyUrl = copy || '';
    joinUrl = join || '';
    document.getElementById('copy-link').value = copyUrl;
    document.getElementById('modal2').classList.remove('hidden');
  }
  function closeModal2() {
    document.getElementById('modal2').classList.add('hidden');
  }

  // кнопки
  const copyBtn  = document.getElementById('copyBtn');
  const joinBtn  = document.getElementById('joinBtn');
  const closeBtn = document.getElementById('closeBtn');
  const closeX   = document.getElementById('closeModal');
  const overlay  = document.getElementById('modal2-overlay');
  const toast    = document.getElementById('toast');

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyUrl);
    } catch {
      const ta = document.getElementById('copy-link');
      ta.select(); document.execCommand('copy');
    }
    toast.classList.remove('invisible','opacity-0');
    setTimeout(()=>toast.classList.add('opacity-0'),1200);
    setTimeout(()=>toast.classList.add('invisible'),1600);
  });

  joinBtn.addEventListener('click', () => {
    if (joinUrl) window.open(joinUrl,'_blank','noopener');
  });
  [closeBtn, closeX, overlay].forEach(el=>el.addEventListener('click', closeModal2));
  document.addEventListener('keydown', e=>{if(e.key==='Escape') closeModal2();});

  // Отслеживаем клик по ссылке с href="#lesson"
  $('a[href="#lesson"]').on("click", function (e) {
    e.preventDefault(); // отменяем переход по ссылке
    $.ajax({
      type: 'GET',
      url: '/getvlinks',
      contentType: 'application/json',
      //data: JSON.stringify(payload),
      xhrFields: {
        withCredentials: true
      },
      success: function (datas) {
        console.log(datas);
        datas.roomid = window.location.href.split('#')[0] + datas.roomid
        console.log(datas.acc);
        openModal2(datas.roomid, datas.link, datas.acc);
      },
      error: function (jqXHR, textStatus, errorThrown) {
        console.error("Ошибка отправки:", textStatus, errorThrown);
      }
    });
   // 

    
  });

  
  $("#openModal").on("click", function () {
    $("#modal").removeClass("hidden");
  });

  $("#closeModal").on("click", function () {
    $("#modal").addClass("hidden");
  });
});
</script>

<script>
$(function(){
  function sendState(){
    let pub = $("#privacyInput").val() === "public";
    let needAuth = $("#requireAuth").is(":checked");
    
    $.ajax({
      type: 'GET',
      url: `/getvlinks`,
      data: {
        pub: pub,
        need_auth: needAuth
      },
      contentType: 'application/json',
      xhrFields: { withCredentials: true },
      success: function(res){ 
        console.log("Сервер ответил:", res); 
      },
      error: function(err){ 
        console.error("Ошибка:", err); 
      }
    });
  }

  // событие на сегменте «Публичная/Частная»
  $("#privacyGroup .seg").on("click", function(){
    $("#privacyInput").val($(this).data("value"));
    sendState();
  });

  // событие на чекбоксе
  $("#requireAuth").on("change", function(){
    sendState();
  });
});
</script>

