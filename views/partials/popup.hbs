<!-- Вход в систему-->
<div id="modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
  <div class="bg-gray-800 text-white p-6 rounded-2xl max-w-md w-full shadow-xl relative">
    <button id="closeModal" class="absolute top-3 right-3 text-gray-400 hover:text-white text-xl">&times;</button>
    <h3 class="text-xl font-semibold mb-4">Вход в систему</h3>
    <!-- Здесь форма авторизации -->
    <form>
      <input id="pass" name="pin" type="password" placeholder="PIN" class="w-full mb-4 p-2 rounded bg-gray-700 border border-gray-600 focus:outline-none" />
      <button id="btnlogin" class="mb-2 w-full py-2 bg-blue-600 hover:bg-blue-500 rounded font-medium">Войти</button>
    </form>
    <div class="text-center mt-auto">
      <a href="https://t.me/Platonicsbot"
         class="block w-full p-1 min-h-[10px] rounded bg-red-800 hover:bg-red-700 text-white shadow-lg transition-all duration-200 ease-in-out transform hover:shadow-l">
         Восстановить PIN
      </a>
    </div>
  </div>
</div>

 <!-- V call -->
<div id="modal2" class="fixed inset-0 z-50 hidden">
 
  <div id="modal2-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- dialog -->
  <div class="relative mx-auto my-8 w-full max-w-xl">
    <div class="bg-gray-800 text-white shadow-xl rounded-2xl p-6 relative">
      <button id="closeModal"
              class="absolute top-3 right-3 h-9 w-9 flex items-center justify-center rounded-full text-gray-400 hover:text-white hover:bg-white/10">
        &times;
      </button>

      <h3 class="text-xl font-semibold mb-2">Ссылка на конференцию</h3>
      <p class="text-sm text-gray-300 mb-4">Скопируйте ссылку-приглашение и нажмите войти</p>

      <!-- Поле для длинной ссылки -->
      <div class="flex gap-2">
        <textarea id="copy-link" readonly
                  class="flex-1 h-28 resize-y rounded-xl bg-gray-900/70 border border-gray-700 p-3 text-sm leading-relaxed
                         focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        <button id="copyBtn"
                class="shrink-0 h-28 w-28 rounded-xl bg-gray-700 hover:bg-gray-600 text-sm font-medium">
          Скопировать
        </button>
      </div>
      
      <!-- Приватность и авторизация -->
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <!-- Сегменты: Публичная / Частная -->
        <fieldset id="privacyGroup" role="radiogroup" aria-label="Тип комнаты"
          class="rounded-xl bg-gray-800 border border-gray-700 p-2">
          <input type="hidden" id="privacyInput" name="privacy" value="public">
          <div class="grid grid-cols-2 gap-2">
            <button type="button" role="radio" aria-checked="true" data-value="public"
              class="seg active inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm transition
                    bg-blue-600 text-white">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 100 18 9 9 0 000-18Zm0 4.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3ZM9 17h6a3 3 0 00-6 0Z" stroke="currentColor" stroke-width="1.5"/></svg>
              Публичная
            </button>
            <button type="button" role="radio" aria-checked="false" data-value="private"
              class="seg inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm transition
                    bg-gray-700 text-gray-200 hover:bg-gray-600">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M17 11V8a5 5 0 10-10 0v3M6 11h12v8H6v-8Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Частная
            </button>
          </div>
          <p id="privacyHint" class="mt-2 text-xs text-gray-400">Ссылку видят все с доступом к странице.</p>
        </fieldset>

        <!-- Тумблер: Требовать авторизацию -->
        <label class="group flex items-center justify-between gap-3 rounded-xl bg-gray-800 border border-gray-700 p-3">
          <div>
            <div class="text-sm text-gray-200">Требовать авторизацию</div>
            <div class="text-xs text-gray-400">Гости войдут только под аккаунтом.</div>
          </div>
          <span class="relative inline-flex h-7 w-12 items-center">
            <input id="requireAuth" name="require_auth" type="checkbox" class="peer sr-only">
            <span aria-hidden="true"
              class="absolute inset-0 rounded-full bg-gray-600 peer-checked:bg-blue-600 transition-colors"></span>
            <span aria-hidden="true"
              class="absolute left-1 h-5 w-5 rounded-full bg-white shadow transition-transform
                    peer-checked:translate-x-5"></span>
          </span>
        </label>
      </div>

      <!-- Кнопка для входа -->
      <div class="mt-4 flex flex-col sm:flex-row gap-2">
        <button id="joinBtn"
                class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 font-medium">
          Зайти в конференцию
        </button>
        <button id="closeBtn"
                class="w-full py-2.5 rounded-xl bg-gray-700 hover:bg-gray-600 font-medium">
          Закрыть
        </button>
      </div>

      <!-- toast -->
      <div id="toast" class="pointer-events-none invisible opacity-0 transition
                             fixed left-1/2 -translate-x-1/2 bottom-6
                             bg-gray-900 text-white text-sm px-3 py-2 rounded-lg">
        Ссылка скопирована
      </div>
    </div>
  </div>
</div>

