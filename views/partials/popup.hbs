<!-- Вход в систему -->
<div id="modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm">
  <div role="dialog" aria-modal="true" aria-labelledby="login-modal-title" class="relative w-full max-w-md rounded-lg border border-slate-200 bg-white p-6 text-slate-950 shadow-2xl">
    <button id="closeLoginModal" type="button" class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-lg text-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="Закрыть">
      &times;
    </button>
    <h3 id="login-modal-title" class="mb-4 text-xl font-semibold">Вход по PIN</h3>
    {{> pinForm pinId="modal-pin" loginError=""}}
  </div>
</div>

<!-- V.CALL -->
<div id="modal2" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 p-4 backdrop-blur-sm">

  <div role="dialog" aria-modal="true" aria-labelledby="vcallTitle" class="relative mx-auto my-8 w-full max-w-xl">
    <div class="relative rounded-lg border border-slate-200 bg-white p-5 text-slate-950 shadow-2xl md:p-6">
      <button id="closeVcallModal" type="button"
              class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-lg text-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              aria-label="Закрыть">
        &times;
      </button>

      <h3 id="vcallTitle" class="mb-2 pr-10 text-xl font-semibold">Начать урок</h3>
      <p id="vcallStatus" role="status" class="mb-4 text-sm text-slate-600"></p>

      <div id="vcallInvite" hidden class="space-y-2">
        <p class="text-xs text-slate-600">Зайдите в конференцию, чтобы комната не закрылась, пока в ней никого нет.</p>
        <label for="copy-link" class="block text-sm font-medium text-slate-700">Ссылка для участников</label>
        <input id="copy-link" type="text" readonly
               class="w-full rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-950 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
        <button id="copyBtn" type="button" class="rounded-lg bg-slate-100 px-4 py-2.5 text-sm font-medium text-slate-900 hover:bg-slate-200">
          Скопировать
        </button>
      </div>

      <fieldset id="vcallSettings" hidden class="space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
        <legend class="px-1 text-sm font-medium">Доступ к комнате</legend>
        <label class="flex items-start gap-2 text-sm">
          <input id="vcallPublic" type="checkbox" checked class="mt-0.5 rounded text-blue-600" />
          <span>Показывать в списке активных комнат</span>
        </label>
        <label class="flex items-start gap-2 text-sm">
          <input id="requireAuth" type="checkbox" class="mt-0.5 rounded text-blue-600" />
          <span>Требовать вход по PIN</span>
        </label>
      </fieldset>

      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <button id="vcallCreate" type="button" hidden
                class="w-full rounded-lg bg-blue-600 py-2.5 font-medium text-white hover:bg-blue-700">
          Открыть комнату
        </button>
        <a id="joinBtn" hidden target="_blank" rel="noopener"
           class="w-full rounded-lg bg-blue-600 py-2.5 text-center font-medium text-white hover:bg-blue-700">
          Зайти в конференцию
        </a>
        <button id="vcallRetry" type="button" hidden
                class="w-full rounded-lg bg-blue-600 py-2.5 font-medium text-white hover:bg-blue-700">
          Повторить
        </button>
        <button id="closeBtn" type="button"
                class="w-full rounded-lg bg-slate-100 py-2.5 font-medium text-slate-900 transition hover:bg-slate-200">
          Закрыть
        </button>
      </div>

    </div>
  </div>
</div>

<!-- Активные комнаты -->
<div id="roomsModal" class="fixed inset-0 z-[100] hidden overflow-y-auto bg-black/60 p-4 backdrop-blur-sm">

  <div role="dialog" aria-modal="true" aria-labelledby="roomsTitle" class="relative mx-auto my-10 w-full max-w-2xl">
    <div class="relative rounded-lg border border-slate-200 bg-white p-5 text-slate-950 shadow-2xl md:p-6">
      <button id="roomsClose" type="button"
              class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-lg text-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              aria-label="Закрыть">
        &times;
      </button>

      <h3 id="roomsTitle" class="mb-1 text-xl font-semibold">Активные комнаты</h3>
      <div id="roomsList" class="grid gap-3 sm:grid-cols-2"></div>

      <p id="roomsStatus" role="status" class="py-4 text-sm text-slate-600"></p>

      <div class="mt-4 flex justify-end gap-2">
        <button id="roomsRetry" type="button" hidden
                class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700">
          Обновить список
        </button>
        <button id="roomsClose2" type="button"
                class="rounded-lg bg-slate-100 px-4 py-2 font-medium text-slate-900 transition hover:bg-slate-200">
          Закрыть
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const qs = selector => document.querySelector(selector);

  const vcallModal = qs('#modal2');
  const roomsModal = qs('#roomsModal');
  const vcallStatus = qs('#vcallStatus');
  const vcallSettings = qs('#vcallSettings');
  const vcallInvite = qs('#vcallInvite');
  const createButton = qs('#vcallCreate');
  const lessonRetry = qs('#vcallRetry');
  const joinButton = qs('#joinBtn');
  const copyLink = qs('#copy-link');
  const roomsList = qs('#roomsList');
  const roomsStatus = qs('#roomsStatus');
  const roomsRetry = qs('#roomsRetry');
  let dialog;
  let previousFocus;
  let previousOverflow;
  let request;
  let creatingRoom = false;

  function openDialog(element) {
    if (dialog) closeDialog();
    previousFocus = document.activeElement;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialog = element;
    dialog.classList.remove('hidden');
    dialog.querySelector('button')?.focus();
  }

  function closeDialog() {
    if (!dialog) return;
    request?.abort();
    dialog.classList.add('hidden');
    dialog = null;
    document.body.style.overflow = previousOverflow;
    previousFocus?.focus();
  }

  async function getJson(url, controller, fallback, body) {
    const headers = { Accept: 'application/json' };
    if (body) headers['Content-Type'] = 'application/json';
    const timeout = new AbortController();
    const cancel = () => timeout.abort();
    controller.signal.addEventListener('abort', cancel, { once: true });
    const timer = window.setTimeout(cancel, 15000);
    try {
      const response = await fetch(url, {
        method: body ? 'POST' : 'GET',
        body: body ? JSON.stringify(body) : undefined,
        credentials: 'same-origin',
        cache: 'no-store',
        headers,
        signal: timeout.signal,
      });
      const data = await response.json().catch(() => null);
      if (!response.ok || !data) throw new Error(data?.message || fallback);
      return data;
    } catch (error) {
      if (timeout.signal.aborted) throw new Error(fallback);
      throw error;
    } finally {
      window.clearTimeout(timer);
      controller.signal.removeEventListener('abort', cancel);
    }
  }

  async function loadLesson(create = false) {
    if (creatingRoom) return;
    if (dialog !== vcallModal) openDialog(vcallModal);
    request?.abort();
    const controller = new AbortController();
    request = controller;
    creatingRoom = create;
    vcallStatus.textContent = create ? 'Открываем комнату…' : 'Проверяем, открыта ли комната…';
    vcallSettings.hidden = vcallInvite.hidden = createButton.hidden = joinButton.hidden = lessonRetry.hidden = true;
    joinButton.removeAttribute('href');

    const body = create ? { pub: qs('#vcallPublic').checked, need_auth: qs('#requireAuth').checked } : undefined;
    try {
      const data = await getJson('/getvlinks', controller, 'Не удалось загрузить комнату. Попробуйте ещё раз.', body);
      if (controller.signal.aborted) return;
      if (data.active === false) {
        vcallStatus.textContent = 'Выберите настройки доступа перед открытием комнаты.';
        vcallSettings.hidden = createButton.hidden = false;
        createButton.focus();
        return;
      }
      if (data.active !== true || !data.roomid || !data.joinPath || typeof data.acc?.pub !== 'boolean' || typeof data.acc?.need_auth !== 'boolean') {
        throw new Error('Не удалось получить приглашение в комнату.');
      }
      const invite = new URL(data.roomid, location.origin);
      const join = new URL(data.joinPath, location.origin);
      if ([invite, join].some(url => url.origin !== location.origin || url.pathname !== '/jointo')) throw new Error('Приглашение недоступно.');
      const visibility = data.acc.pub ? 'Комната в списке активных комнат.' : 'Комната доступна по ссылке.';
      const login = data.acc.need_auth ? ' Для входа нужен PIN.' : ' Гости могут подключиться без PIN.';
      vcallStatus.textContent = visibility + login;
      copyLink.value = invite.href;
      joinButton.href = join.href;
      vcallInvite.hidden = joinButton.hidden = false;
      joinButton.focus();
    } catch (error) {
      if (controller.signal.aborted) return;
      vcallStatus.textContent = error instanceof TypeError ? 'Не удалось загрузить комнату. Проверьте соединение.' : error.message;
      lessonRetry.hidden = false;
      lessonRetry.focus();
    } finally {
      creatingRoom = false;
    }
  }

  function renderRooms(rooms) {
    for (const { room_info: room } of rooms) {
      const link = document.createElement('a');
      link.href = `/jointo?${new URLSearchParams({ roomid: room.room_id })}`;
      link.className = 'block rounded-lg border border-slate-200 bg-slate-50 p-4 hover:bg-white focus-visible:ring-2 focus-visible:ring-blue-500';
      const title = document.createElement('span');
      title.className = 'block break-words font-medium';
      title.textContent = room.room_title || 'Онлайн-урок';
      const people = document.createElement('span');
      people.className = 'mt-1 block text-xs text-slate-600';
      people.textContent = `Участников: ${room.joined_participants ?? 0}`;
      link.append(title, people);
      roomsList.append(link);
    }
  }

  async function loadRooms() {
    if (dialog !== roomsModal) openDialog(roomsModal);
    request?.abort();
    const controller = new AbortController();
    request = controller;
    roomsList.replaceChildren();
    roomsStatus.textContent = 'Загружаем активные комнаты…';
    roomsRetry.hidden = true;
    try {
      const data = await getJson('/rooms', controller, 'Не удалось загрузить комнаты. Попробуйте ещё раз.');
      if (controller.signal.aborted) return;
      if (!Array.isArray(data.rooms)) throw new Error('Не удалось загрузить комнаты.');
      renderRooms(data.rooms);
      roomsStatus.textContent = data.rooms.length ? '' : 'Сейчас нет открытых комнат в списке.';
      window.dispatchEvent(new CustomEvent('portal:rooms-loaded', { detail: data }));
    } catch (error) {
      if (controller.signal.aborted) return;
      roomsStatus.textContent = error instanceof TypeError ? 'Не удалось загрузить комнаты. Проверьте соединение.' : error.message;
      window.dispatchEvent(new CustomEvent('portal:rooms-loaded', { detail: null }));
    }
    roomsRetry.hidden = false;
  }

  qs('#copyBtn').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyLink.value);
      window.PortalToast?.success?.('Ссылка скопирована');
    } catch {
      copyLink.focus();
      copyLink.select();
      window.PortalToast?.show?.('Скопируйте выделенную ссылку вручную', 'info');
    }
  });

  createButton.addEventListener('click', () => loadLesson(true));
  lessonRetry.addEventListener('click', () => loadLesson());
  roomsRetry.addEventListener('click', loadRooms);
  for (const selector of ['#closeBtn', '#closeVcallModal', '#roomsClose', '#roomsClose2']) {
    qs(selector).addEventListener('click', closeDialog);
  }
  for (const element of [vcallModal, roomsModal]) {
    element.addEventListener('click', event => {
      if (event.target === element) closeDialog();
    });
  }

  document.addEventListener('click', (event) => {
    if (event.target.closest('a[href="#lesson"]')) {
      event.preventDefault();
      loadLesson();
    } else if (event.target.closest('a[href="#room"]')) {
      event.preventDefault();
      loadRooms();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog) return;
    if (event.key === 'Escape') {
      closeDialog();
    } else if (event.key === 'Tab') {
      const focusable = [...dialog.querySelectorAll('a[href],button,input')].filter(element => element.getClientRects().length);
      const first = focusable[0];
      const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
})();
</script>
