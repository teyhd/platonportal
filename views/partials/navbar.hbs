<header class="fixed inset-x-0 top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="group flex min-h-[44px] min-w-0 items-center gap-3 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" aria-label="На главную">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-950 text-sm font-semibold text-white shadow-sm shadow-slate-950/20">
        Г
      </span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-semibold leading-tight text-slate-950 md:text-base">{{title}}</span>
        <span class="hidden text-xs font-medium text-slate-500 sm:block">единый центр сервисов</span>
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <button id="theme" class="rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" title="Сменить тему" hidden>🌞</button>
      {{#if auth}}
        <button id="logoutBtn" class="min-h-[44px] rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition duration-150 hover:bg-red-100 active:translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">
          Выйти
        </button>
      {{else}}
        <button id="openModal" class="min-h-[44px] rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-blue-900/10 transition duration-150 hover:bg-blue-700 active:translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2">
          Войти
        </button>
      {{/if}}
    </div>
  </div>
</header>
<script>

$(function () {
  const $btn = $('#theme');
  const root = document.documentElement;

  function isSystemDark() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function applyTheme(theme) {
    if (theme === 'dark') {
      root.classList.add('dark');
      $btn.text('🌙');
    } else {
      root.classList.remove('dark');
      $btn.text('🌞');
    }
  }

  const savedTheme = localStorage.getItem('theme');
  applyTheme(savedTheme || (isSystemDark() ? 'dark' : 'light'));

  $btn.on('click', function () {
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    $btn.text(isDark ? '🌙' : '🌞');
  });
});

</script>


<div id="tg-inapp-banner"
     class="sticky top-0 z-[1000] hidden"
     role="region" aria-label="Ограничения встроенного браузера">
  <div class="w-full pointer-events-auto" style="padding-top: env(safe-area-inset-top);">
    <div class="mx-auto max-w-6xl">
      <div class="m-2 rounded-lg bg-gray-900 text-white shadow-lg ring-1 ring-white/10">
        <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm leading-5">
            <strong class="font-semibold">Вы открыли сайт внутри Telegram!</strong><br>
            Часть функций (единый вход, V.CALL) может не работать корректно.
            Откройте сайт в обычном браузере. 
            <br>Как открыть (кнопка в правом верхнем углу):<br>iPhone: нажмите ••• → «Открыть в браузере» (Safari).<br>Android: меню ⋮ → «Открыть в Chrome».
          </p>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="tg-open-external"
              class="inline-flex items-center justify-center rounded-lg px-3 py-2 text-sm
                     bg-white text-gray-900 hover:bg-gray-100 focus-visible:outline-none
                     focus-visible:ring-2 focus-visible:ring-blue-500">
              Открыть в браузере
            </button>
            <button type="button" id="tg-copy-link"
              class="inline-flex items-center justify-center rounded-lg px-3 py-2 text-sm
                     bg-transparent text-white ring-1 ring-inset ring-white/30 hover:bg-white/10
                     focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
              Скопировать ссылку
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  const banner = document.getElementById('tg-inapp-banner');

  // --- Клиентские эвристики (фолбэк для iOS/случаев без заголовка) ---
  function clientHeuristics() {
    const ua = navigator.userAgent || '';
    const ref = document.referrer || '';
    const isAndroid = /Android/i.test(ua);
    const isiOS = /iPhone|iPad|iPod/i.test(ua);

    const isTGUA   = /\b(Telegram|TgApp)\b/i.test(ua);
    const isTGRef  = /\b(t\.me|telegram\.me)\b/i.test(ref);
    const isAndroidWV = isAndroid && (/\bwv\b/i.test(ua) || /Android.*Version\/\d+\./i.test(ua));
    const hasSafariToken = /Safari/i.test(ua);
    const hasCriOS = /CriOS/i.test(ua);
    const isIOSWV = isiOS && /AppleWebKit/i.test(ua) && !hasSafariToken && !hasCriOS;

    return (isTGUA || isTGRef || isAndroidWV || isIOSWV);
  }

  async function shouldShowBanner() {
    // 1) Сначала пробуем серверный сигнал (главный критерий)
    try {
      const r = await fetch('/tg-probe', {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'Accept': 'application/json' }
      });
      if (r.ok) {
        const j = await r.json();
        if (j.isTelegramHeader === true) return true;   // точное попадание (Android Telegram)
        // Если сервер также отдаёт isTelegramUA/isTMeRef — можно усилить решение:
        if (j.isTelegramUA || j.isTMeRef) return true;
      }
    } catch (_) {}

    // 2) Фолбэк: клиентские эвристики (iOS / нет доступа к заголовкам)
    return clientHeuristics();
  }

  // Показ баннера
  (async () => {
    if (!banner) return;
    if (await shouldShowBanner()) {
      banner.classList.remove('hidden');
    }
  })();

  // Действия кнопок
  const openBtn = document.getElementById("tg-open-external");
  const copyBtn = document.getElementById("tg-copy-link");

  openBtn?.addEventListener("click", () => {
    const ua = navigator.userAgent || "";
    const url = location.href;

    if (/Android/i.test(ua)) {
      // Попытка открыть Chrome через intent (работает на многих прошивках Telegram)
      const intent = `intent://${location.host}${location.pathname}${location.search}#Intent;scheme=${location.protocol.replace(':','')};package=com.android.chrome;end`;
      try { location.href = intent; } catch {}
      setTimeout(() => window.open(url, "_blank"), 300);
      return;
    }
    // iOS: прямого способа нет
    try { navigator.clipboard?.writeText(url); } catch {}
    alert('На iOS нажмите ••• → «Открыть в браузере» (Safari). Ссылка скопирована.');
    window.open(url, "_blank");
  });

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      copyBtn.textContent = "Ссылка скопирована";
      setTimeout(() => (copyBtn.textContent = "Скопировать ссылку"), 2000);
    } catch {
      prompt("Скопируйте ссылку:", location.href);
    }
  });

  // Respect reduced motion
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    banner.classList.remove("transition-all","duration-200");
  }
})();
</script>
