<details class="portal-preferences" data-portal-preferences>
  <summary class="portal-preferences__trigger">
    {{#if (or isSignedIn auth)}}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2"/></svg>
      <span>Аккаунт</span>
    {{else}}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 14a8.8 8.8 0 0 1-10.9-10.8A9 9 0 1 0 20.8 14Z"/></svg>
      <span>Тема</span>
    {{/if}}
    <svg class="portal-preferences__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </summary>

  <div class="portal-preferences__panel">
    <fieldset class="portal-preferences__choices">
      <legend>Тема оформления</legend>
      <label class="portal-preferences__option">
        <input class="sr-only" type="radio" name="portal-theme" value="system" checked>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-4 0h8"/></svg>Системная</span>
      </label>
      <label class="portal-preferences__option">
        <input class="sr-only" type="radio" name="portal-theme" value="light">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>Светлая</span>
      </label>
      <label class="portal-preferences__option">
        <input class="sr-only" type="radio" name="portal-theme" value="dark">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 14a8.8 8.8 0 0 1-10.9-10.8A9 9 0 1 0 20.8 14Z"/></svg>Тёмная</span>
      </label>
    </fieldset>
    {{> @partial-block}}
  </div>
</details>
