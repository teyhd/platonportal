<section class="important-panel" data-important{{#if family}} data-portal-family data-portal-child="{{family.selected.id}}"{{/if}} aria-labelledby="important-title" hidden>
  <div class="important-heading">
    <div class="important-heading-main">
      <h2 id="important-title">Актуально</h2>
      <div class="important-contexts" data-important-contexts hidden role="group" aria-label="Область сводки">
        <button type="button" data-context="personal" aria-pressed="true">Личное</button>
        <button type="button" data-context="school" aria-pressed="false">Школа</button>
      </div>
    </div>
    <div class="important-heading-side">
      <div class="important-clock" data-important-clock hidden></div>
      <button type="button" class="important-refresh" data-important-refresh aria-label="Обновить важную информацию">Обновить</button>
    </div>
  </div>
  <div class="important-toolbar">
    <label data-important-family hidden>Ребёнок <select data-important-child aria-label="Выбрать ребёнка"></select></label>
    <p class="important-source-status" data-important-sources role="status">Загружаем вашу сводку…</p>
  </div>
  <p class="important-update" data-important-update role="status" hidden>Расписание обновлено</p>
  {{#if showBookpc}}
  <section data-important-rentals aria-label="Активная аренда ПК" hidden></section>
  <section data-important-laptop-locations aria-label="Где находится ноутбук" hidden></section>
  {{/if}}
  <details class="important-workday" data-important-workday hidden>
    <summary>
      <span data-important-workday-title></span>
      <span data-important-workday-time></span>
    </summary>
    <div data-important-workday-details></div>
  </details>
  <div class="important-items" id="important-items" data-important-items></div>
  <div class="important-footer">
    <p data-important-day></p>
    <button type="button" data-important-more aria-expanded="false" aria-controls="important-items" hidden></button>
  </div>
  <p class="sr-only" data-gamification-notice role="status"></p>
  <details class="important-gamification" data-important-gamification hidden>
    <summary>
      <span>Геймификация</span>
      <span data-gamification-count></span>
    </summary>
    <div class="important-grading-body">
      <div class="important-grading-tools">
        <label hidden>
          <span class="sr-only">Найти ученика в геймификации</span>
          <input type="search" placeholder="Имя или класс">
        </label>
        <a href="https://points.platoniks.ru/">Журнал</a>
      </div>
      <div data-gamification-list></div>
      <p class="important-grade-feedback" data-gamification-message role="status"></p>
      <button type="button" data-gamification-retry hidden>Повторить загрузку</button>
      <button type="button" data-gamification-more hidden></button>
    </div>
  </details>
  <ul class="important-pending-reports" data-important-pending-reports aria-label="Незаполненные отчётные карточки" hidden></ul>
  <details class="important-approvals" data-important-approvals hidden>
    <summary>
      <span>Мероприятия для утверждения</span>
      <span class="important-approval-count" data-important-approval-count></span>
    </summary>
    <ul data-important-approval-list></ul>
  </details>
  <section class="important-orders" data-important-orders aria-labelledby="important-orders-title" hidden>
    <div class="important-orders-heading">
      <h3 id="important-orders-title">Мои заказы</h3>
      <a href="https://buy.platoniks.ru/myorders">Все заказы</a>
    </div>
    <ul data-important-orders-list></ul>
    <details data-important-orders-more hidden>
      <summary></summary>
      <ul></ul>
    </details>
  </section>
  <noscript>Для обновления сводки включите JavaScript. Расписание и посещаемость доступны в каталоге сервисов.</noscript>
</section>
<link rel="stylesheet" href="/css/important.css?v=gamification-1">
<link rel="stylesheet" href="/css/important-services.css?v=laptop-locations-2">
<script type="module" src="/js/important.js?v=gamification-1"></script>
