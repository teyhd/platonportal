# MainPortal: copy the required names into the existing environment configuration.
# Enable only after both source adapters are deployed and configured.
IMPORTANT_ENABLED=0
# Keep disabled until the production pilot completes. Optional comma-separated pilot SSO IDs.
IMPORTANT_EXPANDED_ENABLED=0
IMPORTANT_EXPANDED_PILOT_IDS=
# Internal base URLs of bestschedule and attendance-1 (no browser traffic to these URLs).
MAINPORTAL_SCHEDULE_URL=
MAINPORTAL_ATTENDANCE_URL=
# Must match MAINPORTAL_INTEGRATION_TOKEN in bestschedule.
MAINPORTAL_SCHEDULE_TOKEN=
# Dedicated shared HMAC key; same value in attendance-1.
ATTENDANCE_MAINPORTAL_SERVICE_KEY=
# Existing Attendance service ID in SSO; default is 13.
ATTENDANCE_SSO_SERVICE_ID=13
# Internal base URLs and distinct per-source keys matching MAINPORTAL_CONTEXT_KEY.
MAINPORTAL_DIARY_URL=
MAINPORTAL_DIARY_KEY=
MAINPORTAL_CALENDAR_URL=
MAINPORTAL_CALENDAR_KEY=
MAINPORTAL_PROGRESS_URL=
MAINPORTAL_PROGRESS_KEY=
